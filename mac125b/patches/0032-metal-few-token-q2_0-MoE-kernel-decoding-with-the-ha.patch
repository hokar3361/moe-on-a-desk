     static const bool en = getenv("GGML_METAL_MOE_MT") == nullptr || atoi(getenv("GGML_METAL_MOE_MT")) != 0;
@@ -3152,6 +3164,44 @@ int ggml_metal_op_mul_mat_id(ggml_metal_op_t ctx, int idx) {
 
             ggml_metal_encoder_dispatch_threadgroups(enc, (ne21 + 31)/32, (ne01 + 63)/64, ne02, 128, 1, 1);
         }
