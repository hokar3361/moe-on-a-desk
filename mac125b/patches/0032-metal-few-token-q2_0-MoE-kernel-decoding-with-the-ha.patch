+// GGML_METAL_MOE_V3 (default on): few-token MoE kernels decoding with the half2 magic (kernel_moe_v3_*), tokens of one expert grouped
+static bool ggml_metal_moe_v3_ok(const ggml_tensor * op, int64_t ne21) {
+    static const bool en = getenv("GGML_METAL_MOE_V3") == nullptr || atoi(getenv("GGML_METAL_MOE_V3")) != 0;
+    if (!en || ne21 > 8 || op->src[1]->type != GGML_TYPE_F32) {
+        return false;
+    }
+    switch (op->src[0]->type) {
+        case GGML_TYPE_Q2_0:    return op->src[0]->ne[0] % 64 == 0;
+        default: return false;
+    }
+}
