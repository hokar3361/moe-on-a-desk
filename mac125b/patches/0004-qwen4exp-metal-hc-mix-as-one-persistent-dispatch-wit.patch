+#define GGML_METAL_SYNC_SLOTS        256
+#define GGML_METAL_SYNC_ERR_IDX      (2*GGML_METAL_SYNC_SLOTS)
+#define GGML_METAL_SYNC_SCRATCH_OFFS 4096
+#define GGML_METAL_SYNC_BUF_SIZE     (64*1024)
+
 typedef struct ggml_metal_device * ggml_metal_device_t;
 
 //
@@ -127,6 +135,7 @@ struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_tri
 struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_soft_max          (ggml_metal_library_t lib, const struct ggml_tensor * op);
