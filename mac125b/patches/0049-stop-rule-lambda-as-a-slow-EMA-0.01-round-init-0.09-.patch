From 1c38e520b6602f2bdf1ab51673150b42e3c5b03b Mon Sep 17 00:00:00 2001
From: mac125b <mac125b@example.invalid>
Date: Sun, 11 Oct 2026 20:41:27 +0900
Subject: [PATCH 49/52] stop rule: lambda as a slow EMA (0.01/round, init
 0.09); fix: HC_POST+norm fusion refuses outputs overlapping its inputs
 (without delayed frees the allocator reused the shared block output, ub>=64
 prefill PPL 1.23 -> 253); register/shuffle bitonic top-k (same network,
 identical output); QSA mask scattered from raw selected indices (dead slots
 hit the sentinel row or causally masked cells)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/speculative.cpp                    |  6 +-
 ggml/src/ggml-metal/ggml-metal-device.cpp |  4 +-
 ggml/src/ggml-metal/ggml-metal-ops.cpp    | 17 +++++-
 ggml/src/ggml-metal/kernels/argsort.metal | 73 +++++++++++++++++++++++
 src/models/qwen4exp.cpp                   | 12 ++++
 5 files changed, 108 insertions(+), 4 deletions(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index a2574c4..73d9708 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1578,7 +1578,8 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         // verify GPU+host ms by width (index = tokens in the verify batch)
         float tv[18] = { 0.0f, 17.9f, 21.85f, 25.8f, 28.63f, 31.47f, 34.3f, 37.65f, 41.0f, 44.0f, 47.0f, 50.0f, 53.0f, 56.0f, 59.0f, 62.0f, 65.0f, 68.0f };
         float c_draft = 1.3f;
-        float lam     = 0.07f;          // long-run tokens per ms, EMA over rounds
+        float lam     = 0.09f;          // long-run tokens per ms, slow EMA over rounds (fast tracking stops early after good rounds)
+        float lam_a   = 0.01f;          // EMA weight per round (LLAMA_SPEC_STOP_LAM_A)
         float ema[18];                  // per-position acceptance EMA (0.9), reset per request
         int   cap = 7, dmin = 1;
         int64_t t_prev_us = 0;
@@ -1831,6 +1832,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             sr.cap = params.draft.n_max;
             if (const char * m = getenv("LLAMA_SPEC_DEPTH_MIN")) sr.dmin = std::max(1, atoi(m));
             if (const char * e = getenv("LLAMA_SPEC_STOP_LAM")) sr.lam = (float) atof(e);
+            if (const char * e = getenv("LLAMA_SPEC_STOP_LAM_A")) sr.lam_a = (float) atof(e);
             sr.reset_request();
             LOG_INF("%s: draft stop rule on (cap %d, min %d)\n", __func__, sr.cap, sr.dmin);
         }
@@ -2137,7 +2139,7 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             if (sr.t_prev_us > 0 && sr.last_acc >= 0 && !sr.first_round) {
                 const float ms = (now - sr.t_prev_us)/1000.0f;
                 if (ms > 5.0f && ms < 150.0f) {
-                    sr.lam = 0.9f*sr.lam + 0.1f*(sr.last_acc + 1)/ms;
+                    sr.lam = (1.0f - sr.lam_a)*sr.lam + sr.lam_a*(sr.last_acc + 1)/ms;
                 }
             }
             sr.first_round = sr.t_prev_us == 0;
diff --git a/ggml/src/ggml-metal/ggml-metal-device.cpp b/ggml/src/ggml-metal/ggml-metal-device.cpp
index 3f1fd4c..9fb70d9 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.cpp
