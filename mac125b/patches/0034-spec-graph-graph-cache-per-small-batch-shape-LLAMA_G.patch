@@ -629,7 +629,11 @@ static void ggml_gallocr_allocate_node(ggml_gallocr_t galloc, struct ggml_tensor
         assert(hn->addr.offset == 0);
 
         // try to reuse a parent's buffer (inplace)
-        if (ggml_op_can_inplace(node->op)) {
+        static int no_inplace = -1;
+        if (no_inplace < 0) {
+            no_inplace = getenv("GGML_ALLOC_NO_INPLACE") != NULL;
+        }
+        if (!no_inplace && ggml_op_can_inplace(node->op)) {
             for (int i = 0; i < GGML_MAX_SRC; i++) {
                 struct ggml_tensor * parent = node->src[i];
                 if (parent == NULL) {
@@ -760,11 +764,32 @@ static void ggml_gallocr_alloc_graph_impl(ggml_gallocr_t galloc, struct ggml_cgr
         }
     }
 
+    // delayed frees (GGML_ALLOC_FREE_DELAY): released K nodes after the last consumer
+    static int free_delay = -1;
+    if (free_delay < 0) {
+        const char * env = getenv("GGML_ALLOC_FREE_DELAY");
+        free_delay = env ? atoi(env) : 0;
+    }
+    struct ggml_tensor ** pend_t = NULL;
+    int * pend_at = NULL;
+    int n_pend = 0, n_pend_head = 0;
+    if (free_delay > 0) {
+        pend_t  = (struct ggml_tensor **) malloc(sizeof(struct ggml_tensor *) * (graph->n_nodes*GGML_MAX_SRC + 1));
+        pend_at = (int *) malloc(sizeof(int) * (graph->n_nodes*GGML_MAX_SRC + 1));
+    }
+
     // allocate tensors
     for (int i = 0; i < graph->n_nodes; i++) {
         struct ggml_tensor * node = graph->nodes[i];
         int buffer_id = get_node_buffer_id(node_buffer_ids, i);
 
+        while (n_pend_head < n_pend && pend_at[n_pend_head] <= i) {
+            struct ggml_tensor * t = pend_t[n_pend_head++];
+            if (ggml_gallocr_hash_get(galloc, t)->allocated) {
+                ggml_gallocr_free_node(galloc, t);
+            }
+        }
+
         // allocate parents (only leafs need to be allocated at this point)
         for (int j = 0; j < GGML_MAX_SRC; j++) {
             struct ggml_tensor * parent = node->src[j];
@@ -810,16 +835,27 @@ static void ggml_gallocr_alloc_graph_impl(ggml_gallocr_t galloc, struct ggml_cgr
                     AT_PRINTF("view_src %s: %d children, %d views\n",
                         view_src->name, view_src_hn->n_children, view_src_hn->n_views);
                     if (view_src_hn->n_views == 0 && view_src_hn->n_children == 0 && view_src_hn->allocated) {
-                        ggml_gallocr_free_node(galloc, view_src);
+                        if (free_delay > 0) {
+                            pend_t[n_pend] = view_src; pend_at[n_pend] = i + free_delay; n_pend++;
+                        } else {
+                            ggml_gallocr_free_node(galloc, view_src);
+                        }
                     }
                 }
                 else if (p_hn->allocated) {
-                    ggml_gallocr_free_node(galloc, parent);
+                    if (free_delay > 0) {
+                        pend_t[n_pend] = parent; pend_at[n_pend] = i + free_delay; n_pend++;
+                    } else {
+                        ggml_gallocr_free_node(galloc, parent);
+                    }
                 }
             }
             AT_PRINTF("\n");
         }
     }
+
+    free(pend_t);
+    free(pend_at);
 }
 
