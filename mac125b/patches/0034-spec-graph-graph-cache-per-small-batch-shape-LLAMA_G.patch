From 0e78e81ce77c21b5a930679e405ffa5894bf58ca Mon Sep 17 00:00:00 2001
From: mac125b <mac125b@example.invalid>
Date: Sun, 11 Oct 2026 10:34:57 +0900
Subject: [PATCH 34/49] spec/graph: graph cache per small-batch shape
 (LLAMA_GRAPH_CACHE), delayed frees in the graph allocator
 (GGML_ALLOC_FREE_DELAY), MTP catch-up merged into the first draft step
 (LLAMA_SPEC_MTP_MERGE), depth controller reset per request and
 acceptance-driven exploration, bf16 MMA from 2 rows

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/speculative.cpp                    | 116 +++++++++++++++++++++-
 ggml/src/ggml-alloc.c                     |  42 +++++++-
 ggml/src/ggml-metal/ggml-metal-common.cpp |  14 ++-
 ggml/src/ggml-metal/ggml-metal-context.m  |   4 +-
 ggml/src/ggml-metal/ggml-metal-ops.cpp    |  25 ++++-
 ggml/src/ggml-metal/ggml-metal-ops.h      |   2 +
 src/llama-context.cpp                     |  80 ++++++++++++++-
 src/llama-context.h                       |  13 +++
 8 files changed, 286 insertions(+), 10 deletions(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index 099ea2b..17365a9 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1425,6 +1425,36 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
     std::vector<int>                i_last;
     std::vector<std::vector<float>> chain_h;
 
+    // merged catch-up (LLAMA_SPEC_MTP_MERGE=1): the catch-up over a verify batch is deferred to the next draft() and
+    // decoded together with the first draft step, over the accepted tokens only
+    bool merge = false;
+    std::vector<bool>                   gen;        // a draft() ran since begin()
+    std::vector<bool>                   def_valid;
+    std::vector<llama_tokens>           def_tok;
+    std::vector<std::vector<llama_pos>> def_pos;
+    std::vector<std::vector<float>>     def_h0;     // pending_h at process() time, pairs with def_tok[0]
+    std::vector<int32_t>                def_nacc;
+
+    // run a deferred catch-up on its own (accepted prefix)
+    void mtp_flush(llama_seq_id s) {
+        def_valid[s] = false;
+        const int n = std::min<int>((int) def_tok[s].size(), def_nacc[s] + 1);
+        if (n <= 0) {
+            return;
+        }
+        batch.clear();
+        for (int k = 0; k < n; ++k) {
+            const int32_t idx = batch.add(def_tok[s][k], def_pos[s][k], s, false);
+            const float * h_row = k == 0 ? def_h0[s].data() : verify_h[s].data() + (size_t) (k - 1)*n_embd;
+            batch.set_embd_state(idx, { h_row, 1, (size_t) n_embd });
+        }
+        const int32_t rc = llama_process(params.ctx_dft, LLAMA_PROCESS_TYPE_DECODE, batch.get());
+        if (rc != 0) {
+            SPC_ERR("deferred catch-up failed rc=%d\n", (int) rc);
+        }
+        batch.clear();
+    }
+
     // ---- EV planner (LLAMA_SPEC_EV=1) ----
     struct ev_planner {
         bool enabled = false;
@@ -1694,6 +1724,17 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         verify_h.assign(n_seq, {});
         verify_h_rows.assign(n_seq, 0);
+
+        merge = getenv("LLAMA_SPEC_MTP_MERGE") && atoi(getenv("LLAMA_SPEC_MTP_MERGE")) != 0 && !chain_heads && !is_mem_shared;
+        gen.assign(n_seq, false);
+        def_valid.assign(n_seq, false);
+        def_tok.assign(n_seq, {});
+        def_pos.assign(n_seq, {});
+        def_h0.assign(n_seq, {});
+        def_nacc.assign(n_seq, 0);
+        if (merge) {
+            LOG_INF("%s: MTP catch-up merged into the first draft step\n", __func__);
+        }
     }
 
     ~common_speculative_impl_draft_mtp() override {
@@ -1714,6 +1755,16 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         // reset here rather than per round, or two identical requests differ
         common_sampler_reset(smpls[seq_id].get());
 
+        if (merge) {
+            gen[seq_id]       = false;
+            def_valid[seq_id] = false;
+        }
+
+        // LLAMA_SPEC_DEPTH_RESET=1: the depth controller starts from its priors for every request
+        if (dctl.enabled && getenv("LLAMA_SPEC_DEPTH_RESET") && atoi(getenv("LLAMA_SPEC_DEPTH_RESET")) != 0) {
+            dctl.init(params.n_max);
+        }
+
         const int32_t N = (int32_t) prompt.size();
         if (N <= 0) {
             return;
@@ -1762,8 +1813,33 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
 
         const size_t row_bytes = (size_t) n_embd * sizeof(float);
 
+        // merged catch-up: during generation stash the verify batch, the catch-up runs in the next draft()
+        bool deferred = false;
+        if (merge && batch_in.has_token() && !batch_in.has_embd() && n_tokens <= 16) {
+            const llama_seq_id s0 = batch_in.tokens[0].seq_id;
+            bool one_seq = s0 >= 0 && s0 < (llama_seq_id) n_seq;
+            for (int k = 0; k < n_tokens && one_seq; ++k) {
+                one_seq = batch_in.tokens[k].seq_id == s0 && batch_in.tokens[k].id != LLAMA_TOKEN_NULL;
+            }
+            if (one_seq && gen[s0]) {
+                if (def_valid[s0]) {
+                    mtp_flush(s0);
+                }
+                def_tok[s0].clear();
+                def_pos[s0].clear();
+                for (int k = 0; k < n_tokens; ++k) {
+                    def_tok[s0].push_back(batch_in.tokens[k].id);
+                    def_pos[s0].push_back(batch_in.tokens[k].pos[0]);
+                }
+                def_h0[s0]    = pending_h[s0];
+                def_nacc[s0]  = n_tokens - 1;
+                def_valid[s0] = true;
+                deferred = true;
+            }
+        }
+
         // if kv is shared with target (e.g Gemma4), then we can skip this catch-up decode
-        if (!is_mem_shared) {
+        if (!is_mem_shared && !deferred) {
             batch.clear();
 
             // pair each token with the tgt embedding shifted right by one position, and
@@ -1895,7 +1971,12 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             }
             if (d != dctl.depth) { dctl.depth = d; dctl.rounds_at = 0; }
             dctl.exploring = false;
-            if (++dctl.rounds_at % 16 == 0 && dctl.depth < dctl.cap) {
+            // explore one deeper: often when the last drafted position is usually accepted, rarely otherwise
+            // (LLAMA_SPEC_DEPTH_FASTX=0 keeps the fixed period of 16)
+            static const bool fastx = !getenv("LLAMA_SPEC_DEPTH_FASTX") || atoi(getenv("LLAMA_SPEC_DEPTH_FASTX")) != 0;
+            const float ad = dctl.a[dctl.depth];
+            const int period = !fastx ? 16 : ad >= 0.80f ? 2 : ad >= 0.65f ? 8 : 32;
+            if (++dctl.rounds_at % period == 0 && dctl.depth < dctl.cap) {
                 dctl.exploring = true;
             }
             mtp_depth = dctl.exploring ? dctl.depth + 1 : dctl.depth;
@@ -1903,6 +1984,19 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             dctl.last_depth = mtp_depth;
         }
 
+        if (merge) {
+            for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+                const auto & dp = dparams[seq_id];
+                if (!def_valid[seq_id]) {
+                    continue;
+                }
+                const int n = std::min<int>((int) def_tok[seq_id].size(), def_nacc[seq_id] + 1);
+                if (!dp.drafting || n <= 0 || def_pos[seq_id][n - 1] + 1 != dp.pos0) {
+                    mtp_flush(seq_id);
+                }
+            }
+        }
+
         batch.clear();
 
         // keep track of which sequences are still drafting
@@ -1953,6 +2047,20 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
                 }
             }
 
+            if (merge) {
+                gen[seq_id] = true;
+                if (def_valid[seq_id]) {
+                    // the accepted prefix of the last verify batch, then the new token: one decode
+                    def_valid[seq_id] = false;
+                    const int n = std::min<int>((int) def_tok[seq_id].size(), def_nacc[seq_id] + 1);
+                    for (int k = 0; k < n; ++k) {
+                        const int32_t ik = batch.add(def_tok[seq_id][k], def_pos[seq_id][k], seq_id, false);
+                        const float * h_row = k == 0 ? def_h0[seq_id].data() : verify_h[seq_id].data() + (size_t) (k - 1)*n_embd;
+                        batch.set_embd_state(ik, { h_row, 1, (size_t) n_embd });
+                    }
+                }
+            }
+
             const int32_t idx = batch.add(dp.id_last, dp.pos0, seq_id, true);
             batch.set_embd_state(idx, { pending_h[seq_id].data(), 1, (size_t) n_embd });
 
@@ -2158,6 +2266,10 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             return;
         }
 
+        if (merge && def_valid[seq_id]) {
+            def_nacc[seq_id] = n_accepted;
+        }
+
         if (dctl.enabled) {
             dctl.last_acc = n_accepted;
         }
diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index b0c067b..5727a2b 100644
--- a/ggml/src/ggml-alloc.c
