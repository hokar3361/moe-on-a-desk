From b6656a2aabd4fe80b3757659d1647a04fa3ad7a5 Mon Sep 17 00:00:00 2001
From: mac125b <mac125b@example.invalid>
Date: Sun, 11 Oct 2026 17:55:20 +0900
Subject: [PATCH 46/52] speculative: depth controller round-time fixes (first
 round of a request not measured, first measurement of a depth must be
 plausible, monotone T(d), current verify priors; LLAMA_SPEC_DEPTH_FIX=0
 restores), opt-in KEEP_T / STEP / TRACE, metal command-buffer geometric split
 (opt-in)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/speculative.cpp | 56 ++++++++++++++++++++++++++++++++++++------
 1 file changed, 49 insertions(+), 7 deletions(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index 11ae5d2..ef9eca4 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1579,6 +1579,8 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
         int   dmin = 3;                 // never draft shallower than this (LLAMA_SPEC_DEPTH_MIN)
         int64_t t_prev_us = 0;
         uint64_t rounds = 0;
+        bool inited = false;
+        bool stale[17] = {};   // kept from an earlier request: the first measurement of this request replaces it
 
         void init(int n_max) {
             const char * e = getenv("LLAMA_SPEC_DEPTH_CTL");
@@ -1589,16 +1591,44 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             for (int k = 0; k <= 16; ++k) rate[k] = 0.0f;
             cap = std::min(16, std::max(1, n_max));
             depth = std::min(cap, 3);
-            for (int k = 0; k <= 16; ++k) { a[k] = 0.7f; t[k] = 0.0f; }
-        }
-        // prior round time when unmeasured: measured verify table + 1.5 ms per draft step
-        float T(int d) const {
-            if (t[d] > 0.0f) return t[d];
+            // LLAMA_SPEC_DEPTH_KEEP_T=1 (opt-in): keep round times across requests (bench +10-20%, prose -6% on the fixed metric)
+            static const bool keep_t = getenv("LLAMA_SPEC_DEPTH_KEEP_T") != nullptr && atoi(getenv("LLAMA_SPEC_DEPTH_KEEP_T")) != 0;
+            const bool reset_t = !(fix() && keep_t && inited);
+            for (int k = 0; k <= 16; ++k) { a[k] = 0.7f; if (reset_t) t[k] = 0.0f; stale[k] = true; }
+            inited = true;
+            if (fix()) { t_prev_us = 0; last_depth = 0; last_acc = -1; }
+        }
+        static bool fix() {
+            static const bool v = getenv("LLAMA_SPEC_DEPTH_FIX") == nullptr || atoi(getenv("LLAMA_SPEC_DEPTH_FIX")) != 0;
+            return v;
+        }
+        // prior round time of depth d: verify of d+1 tokens + d draft steps
+        static float prior(int d) {
+            if (fix()) {
+                // verify GPU time by width (2026-10-11 fork, 16k ctx server) + host, and 1.3 ms per draft step
+                static const float v[] = { 0.0f, 18.5f, 23.0f, 26.6f, 29.3f, 32.0f, 35.0f, 38.0f, 41.0f };
+                const int w = d + 1;
+                const float tv = w <= 8 ? v[w] : 41.0f + 3.0f*(w - 8);
+                return tv + 1.3f*d + 0.8f;
+            }
             static const float v[] = { 0.0f, 21.0f, 28.8f, 31.6f, 34.3f, 37.2f, 40.1f, 43.0f, 46.0f };
             const int w = d + 1;
             const float tv = w <= 8 ? v[w] : 46.0f + 3.0f*(w - 8);
             return tv + 1.5f*d;
         }
+        // prior round time when unmeasured: measured verify table + 1.5 ms per draft step
+        float T(int d) const {
+            if (!fix()) {
+                return t[d] > 0.0f ? t[d] : prior(d);
+            }
+            // monotone in d: each extra position costs at least 1 ms more
+            float m = 0.0f;
+            for (int k = 1; k <= d; ++k) {
+                const float raw = t[k] > 0.0f ? t[k] : prior(k);
+                m = std::max(raw, m + 1.0f);
+            }
+            return m;
+        }
         float E(int d) const {
             float e = 1.0f, P = 1.0f;
             for (int k = 1; k <= d; ++k) { P *= a[k]; e += P; }
@@ -2018,8 +2048,15 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
                 float & td = dctl.t[dctl.last_depth];
                 // a round is verify + drafts (< ~100 ms); longer gaps include prompt processing or idle time
                 const float prior = dctl.T(dctl.last_depth);
-                if (ms < 2.0f*prior && ms < 150.0f) {
-                    td = td > 0.0f ? 0.8f*td + 0.2f*ms : ms;
+                // the first measurement of a depth must be plausible: one bad round would otherwise set it alone
+                const bool plausible = !depth_ctl::fix() || td > 0.0f || (ms > 0.6f*depth_ctl::prior(dctl.last_depth) && ms < 1.6f*depth_ctl::prior(dctl.last_depth));
+                static const bool trace = getenv("LLAMA_SPEC_DEPTH_TRACE") != nullptr;
+                if (trace) {
+                    LOG_INF("dctl-trace d=%d ms=%.2f acc=%d prior=%.1f t=%.1f\n", dctl.last_depth, ms, dctl.last_acc, prior, td);
+                }
+                if (plausible && ms < 2.0f*prior && ms < 150.0f) {
+                    td = (td > 0.0f && !dctl.stale[dctl.last_depth]) ? 0.8f*td + 0.2f*ms : ms;
+                    dctl.stale[dctl.last_depth] = false;
                     if (dctl.mode == 2 && dctl.last_acc >= 0) {
                         const float r = (dctl.last_acc + 1)/ms;
                         float & rd = dctl.rate[dctl.last_depth];
@@ -2057,6 +2094,11 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             if (d != dctl.depth && dctl.E(d)/dctl.T(d) < 1.03f*dctl.E(dctl.depth)/dctl.T(dctl.depth)) {
                 d = dctl.depth;   // hysteresis
             }
+            // LLAMA_SPEC_DEPTH_STEP=1: climb one position at a time (opt-in; slower on the fixed metric)
+            static const bool step1 = getenv("LLAMA_SPEC_DEPTH_STEP") && atoi(getenv("LLAMA_SPEC_DEPTH_STEP")) != 0;
+            if (step1 && d > dctl.depth + 1) {
+                d = dctl.depth + 1;
+            }
             if (d != dctl.depth) { dctl.depth = d; dctl.rounds_at = 0; }
             dctl.exploring = false;
             // explore one deeper: often when the last drafted position is usually accepted, rarely otherwise
-- 
