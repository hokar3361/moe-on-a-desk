 template [[host_name("kernel_mul_mv_id_grp_q2_0")]]    kernel kernel_mul_mv_id_grp_t kernel_mul_mv_id_grp<block_q2_0,    4,  dequantize_q2_0>;
+
+// ---- few-token MoE matvec ----------------------------------------------------------------------
+#define MOE_MT_NSG  2
+#define MOE_MT_TMAX 8
+
+// owner test + list of (token, slot) pairs that selected this threadgroup's expert (pairs <= 96)
+static inline bool moe_mt_pairs(
+        constant ggml_metal_kargs_mul_mv_id & args, device const char * ids, int pz, ushort tiisg,
+        thread int32_t & ex, thread short & nm, thread short * qt, thread short * qs) {
+    const int n_pairs = args.nei0*args.nei1;
+    int32_t e[3];
+    for (short k = 0; k < 3; ++k) {
+        const int p = tiisg + 32*k;
+        e[k] = p < n_pairs ? ((device const int32_t *) (ids + (p/args.nei0)*args.nbi1))[p%args.nei0] : -1;
+    }
+    ex = ((device const int32_t *) (ids + (pz/args.nei0)*args.nbi1))[pz%args.nei0];
+    uint m[3];
+    for (short k = 0; k < 3; ++k) {
+        m[k] = (uint) (uint64_t) simd_ballot(e[k] == ex);
+    }
+    const int w = pz/32, b = pz%32;
+    for (short k = 0; k < 3; ++k) {
+        const uint lower = k < w ? 0xffffffffu : (k == w ? ((1u << b) - 1u) : 0u);
+        if (m[k] & lower) {
+            return false;
+        }
+    }
+    nm = 0;
+    for (short k = 0; k < 3; ++k) {
+        for (uint mm = m[k]; mm != 0 && nm < MOE_MT_TMAX; mm &= mm - 1) {
+            const int q = 32*k + ctz(mm);
+            qt[nm] = q/args.nei0;
+            qs[nm] = q%args.nei0;
+            nm++;
+        }
+    }
+    return true;
+}
+
+// iq4_nl: same lane layout as kernel_mul_mv_iq4_nl_f32_impl (lane pair per 32-block, 8 values per lane)
+template <short NR>
+kernel void kernel_moe_mt_iq4_nl(
+        constant ggml_metal_kargs_mul_mv_id & args,
+        device const char * src0s,
+        device const char * src1,
+        device       char * dst,
+        device const char * ids,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    threadgroup float * kv = (threadgroup float *) shmem;
+    if (sgitg == 0) {
+        kv[tiisg] = kvalues_iq4nl_f[tiisg%16];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    int32_t ex; short nm; short qt[MOE_MT_TMAX]; short qs[MOE_MT_TMAX];
+    if (!moe_mt_pairs(args, ids, tgpig.z, tiisg, ex, nm, qt, qs)) {
+        return;
+    }
+
+    const int first_row = (tgpig.x*MOE_MT_NSG + sgitg)*NR;
+    const int nb   = args.ne00/QK4_NL;
+    const int ns01 = args.nb01/args.nb00;
+
+    device const block_iq4_nl * x = (device const block_iq4_nl *) (src0s + ex*args.nb02 + first_row*args.nb01);
+
+    const short ix = tiisg/2;
+    const short it = tiisg%2;
+
+    uint32_t aux32[2];
+    thread const uint8_t * q8 = (thread const uint8_t *) aux32;
+
+    // token-major: activations of one (token, slot) loaded once per block, rows inside; the
+    // expert's row tile stays in cache across the tokens of this threadgroup
+    for (short t = 0; t < nm; ++t) {
+        device const float * yb = (device const float *) (src1 + (qs[t] % args.ne11)*args.nb11 + qt[t]*args.nb12) + ix*QK4_NL + it*8;
+
+        float sumf[NR];
+        for (short r = 0; r < NR; ++r) {
+            sumf[r] = 0.0f;
+        }
+
+        for (int ib = ix; ib < nb; ib += 16) {
+            device const float4 * y4 = (device const float4 *) yb;
+            const float4 yl0 = y4[0], yl1 = y4[4], yl2 = y4[1], yl3 = y4[5];
+
+            for (short row = 0; row < NR; ++row) {
+                device const block_iq4_nl & xb = x[row*ns01 + ib];
+                device const uint16_t * q4 = (device const uint16_t *) (xb.qs + 8*it);
+
+                float4 acc1 = 0.0f, acc2 = 0.0f;
+                aux32[0] = q4[0] | (q4[1] << 16);
+                aux32[1] = (aux32[0] >> 4) & 0x0f0f0f0f;
+                aux32[0] &= 0x0f0f0f0f;
+                acc1 += yl0 * float4(kv[q8[0]], kv[q8[1]], kv[q8[2]], kv[q8[3]]);
+                acc2 += yl1 * float4(kv[q8[4]], kv[q8[5]], kv[q8[6]], kv[q8[7]]);
+                aux32[0] = q4[2] | (q4[3] << 16);
+                aux32[1] = (aux32[0] >> 4) & 0x0f0f0f0f;
+                aux32[0] &= 0x0f0f0f0f;
+                acc1 += yl2 * float4(kv[q8[0]], kv[q8[1]], kv[q8[2]], kv[q8[3]]);
+                acc2 += yl3 * float4(kv[q8[4]], kv[q8[5]], kv[q8[6]], kv[q8[7]]);
+                acc1 += acc2;
+                sumf[row] += (float) xb.d * (acc1[0] + acc1[1] + acc1[2] + acc1[3]);
+            }
+
+            yb += 16*QK4_NL;
+        }
+
+        device float * d = (device float *) (dst + (qs[t]*args.ne0 + qt[t]*args.ne1*args.ne0)*sizeof(float));
+        for (short row = 0; row < NR; ++row) {
+            const float sa = simd_sum(sumf[row]);
+            if (tiisg == 0 && first_row + row < args.ne01) {
+                d[first_row + row] = sa;
+            }
+        }
+    }
+}
+
+typedef decltype(kernel_moe_mt_iq4_nl<8>) kernel_moe_mt_t;
+
+template [[host_name("kernel_moe_mt_iq4_nl")]] kernel kernel_moe_mt_t kernel_moe_mt_iq4_nl<8>;
