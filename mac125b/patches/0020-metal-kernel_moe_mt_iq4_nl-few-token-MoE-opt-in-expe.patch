+// few-token MoE matvec (kernel_moe_mt_*): rows per simdgroup, 0 = not available for this type
+static int ggml_metal_moe_mt_rows(const ggml_tensor * op, int64_t ne20, int64_t ne21) {
+    static const bool en = getenv("GGML_METAL_MOE_MT") == nullptr || atoi(getenv("GGML_METAL_MOE_MT")) != 0;
+    if (!en || ne21 > 8 || ne20*ne21 > 96 || op->src[1]->type != GGML_TYPE_F32) {
+        return 0;
+    }
+    switch (op->src[0]->type) {
+        case GGML_TYPE_IQ4_NL: return 8;
+        default:               return 0;
+    }
+}
