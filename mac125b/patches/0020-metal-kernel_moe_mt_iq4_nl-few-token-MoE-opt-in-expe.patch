diff --git a/ggml/src/ggml-metal/kernels/mul_mv.metal b/ggml/src/ggml-metal/kernels/mul_mv.metal
index 4aa5c28..85a5dd2 100644
--- a/ggml/src/ggml-metal/kernels/mul_mv.metal
+++ b/ggml/src/ggml-metal/kernels/mul_mv.metal
@@ -3536,3 +3536,126 @@ template [[host_name("kernel_mul_mv_id_grp_iq2_xxs")]] kernel kernel_mul_mv_id_g
 template [[host_name("kernel_mul_mv_id_grp_iq2_xs")]]  kernel kernel_mul_mv_id_grp_t kernel_mul_mv_id_grp<block_iq2_xs,  16, dequantize_iq2_xs>;
