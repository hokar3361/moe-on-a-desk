From: mac125b <mac125b@example.invalid>
Date: Sat, 10 Oct 2026 23:24:07 +0900
Subject: [PATCH 19/49] metal: grouped MoE matvec (opt-in, slower than stock),
 dispatch profiling with tensor names

---
 ggml/src/ggml-metal/ggml-metal-device.cpp |  12 +++
 ggml/src/ggml-metal/ggml-metal-device.h   |   1 +
 ggml/src/ggml-metal/ggml-metal-device.m   |   4 +-
 ggml/src/ggml-metal/ggml-metal-ops.cpp    |  67 ++++++++++++-
 ggml/src/ggml-metal/kernels/mul_mv.metal  | 112 ++++++++++++++++++++++
 5 files changed, 193 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-device.cpp b/ggml/src/ggml-metal/ggml-metal-device.cpp
index 96237e7..e7b95b0 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-device.cpp
@@ -547,6 +547,18 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_dsv4_hc(ggml_met
     return res;
 }
 
+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv_id_grp(ggml_metal_library_t lib, ggml_type type) {
+    char name[128];
+    snprintf(name, sizeof(name), "kernel_mul_mv_id_grp_%s", ggml_type_name(type));
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        res = ggml_metal_library_compile_pipeline(lib, name, name, nullptr);
+    }
+
+    return res;
+}
+
 ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_prof_ids(ggml_metal_library_t lib) {
     const char * name = "kernel_prof_ids";
 
