From 8f619d7d8ef2306c832ebd75d184d6b4df476768 Mon Sep 17 00:00:00 2001
From: mac125b <mac125b@example.invalid>
Date: Wed, 14 Oct 2026 13:21:15 +0900
Subject: [PATCH 55/55] qwen35moe MTP: draft-only coarse LM head
 (LLAMA_MTP_COARSE_HEAD, default q1_0): coarse full-vocab scores, top 32
 re-scored with the real rows; the verify pass is unchanged

---
 src/llama-model.cpp      |  2 +-
 src/models/qwen35moe.cpp | 14 +++++++++++++-
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 00c0178..1f40a3e 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2054,7 +2054,7 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
     }
 
     // draft-only coarse LM head for qwen4exp MTP drafting (the MTP sidecar carries a Q8_0 head)
-    if (arch == LLM_ARCH_QWEN4EXP && output && output->type == GGML_TYPE_Q8_0) {
+    if ((arch == LLM_ARCH_QWEN4EXP || arch == LLM_ARCH_QWEN35MOE) && output && output->type == GGML_TYPE_Q8_0) {
         const char * env = getenv("LLAMA_MTP_COARSE_HEAD");
         const std::string want = env ? env : "q1_0";
         ggml_type type = GGML_TYPE_COUNT;
diff --git a/src/models/qwen35moe.cpp b/src/models/qwen35moe.cpp
index 118deeb..f215bbe 100644
--- a/src/models/qwen35moe.cpp
+++ b/src/models/qwen35moe.cpp
@@ -734,7 +734,19 @@ llama_model_qwen35moe::graph_mtp::graph_mtp(const llama_model & model, const llm
     ggml_tensor * head_w = layer.nextn.shared_head_head ? layer.nextn.shared_head_head : model.output;
     ggml_tensor * head_s = layer.nextn.shared_head_head ? layer.nextn.shared_head_head_s : model.output_s;
     GGML_ASSERT(head_w && "QWEN35MOE MTP: missing LM head (nextn.shared_head_head or model.output)");
-    cur = build_lora_mm(head_w, cur, head_s);
+    if (model.output_coarse && head_w == model.output && !head_s && cur->ne[1] == 1) {
+        // draft readout: coarse full-vocab head -> top-32 -> exact re-score with the real head rows; every other logit is -inf
+        const int64_t n_vocab = model.output->ne[1];
+        ggml_tensor * coarse = ggml_mul_mat(ctx0, model.output_coarse, cur);          // [n_vocab, 1]
+        ggml_tensor * idx    = ggml_top_k(ctx0, coarse, 32);                          // [32, 1]
+        ggml_tensor * rows   = ggml_get_rows(ctx0, model.output, idx);                // [n_embd, 32]
+        ggml_tensor * exact  = ggml_mul_mat(ctx0, rows, cur);                         // [32, 1]
+        ggml_tensor * full   = ggml_fill(ctx0, coarse, -INFINITY);                    // [n_vocab, 1]
+        full = ggml_set_rows(ctx0, ggml_reshape_2d(ctx0, full, 1, n_vocab), ggml_reshape_2d(ctx0, exact, 1, 32), idx);
+        cur  = ggml_reshape_2d(ctx0, full, n_vocab, 1);
+    } else {
+        cur = build_lora_mm(head_w, cur, head_s);
+    }
     cb(cur, "result_output", -1);
 
     res->t_logits = cur;
-- 
