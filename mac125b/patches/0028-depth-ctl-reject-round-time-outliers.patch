From e7c75799a73f86506e143794312d1457047c8adc Mon Sep 17 00:00:00 2001
From: mac125b <mac125b@example.invalid>
Date: Sun, 11 Oct 2026 00:29:01 +0900
Subject: [PATCH 28/55] depth ctl: reject round-time outliers

---
 common/speculative.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index b824d70..ed05eaa 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -1843,7 +1843,9 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             if (dctl.t_prev_us > 0 && dctl.last_depth > 0) {
                 const float ms = (now - dctl.t_prev_us)/1000.0f;
                 float & td = dctl.t[dctl.last_depth];
-                if (ms < 1000.0f) {   // ignore gaps between requests
+                // a round is verify + drafts (< ~100 ms); longer gaps include prompt processing or idle time
+                const float prior = dctl.T(dctl.last_depth);
+                if (ms < 2.0f*prior && ms < 150.0f) {
                     td = td > 0.0f ? 0.8f*td + 0.2f*ms : ms;
                 }
             }
