 }
 
+// requantize a 2D weight to `type` into a new buffer of the same buffer type (kept alive in `keep`)
+static ggml_tensor * llama_requantize_copy(
+        const ggml_tensor * src, ggml_type type, const char * name,
+        std::vector<std::pair<ggml_context_ptr, std::vector<ggml_backend_buffer_ptr>>> & keep) {
+    const int64_t n_per_row = src->ne[0];
+    const int64_t n_rows    = ggml_nrows(src);
+    const auto * tr_src = ggml_get_type_traits(src->type);
+    if (!tr_src->to_float || n_per_row % ggml_blck_size(type) != 0) {
+        return nullptr;
+    }
+
+    ggml_init_params ip = { ggml_tensor_overhead()*2, nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * t = ggml_new_tensor_2d(ctx, type, n_per_row, n_rows);
+    ggml_set_name(t, name);
+
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_buffer_get_type(src->buffer));
+    if (!buf) {
+        ggml_free(ctx);
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    const int64_t chunk = 1024;
+    std::atomic<int64_t> next(0);
+    std::mutex mtx;
+    std::vector<std::thread> workers;
+    const int nth = std::max(1, (int) std::thread::hardware_concurrency());
+    for (int i = 0; i < nth; ++i) {
+        workers.emplace_back([&]() {
+            std::vector<uint8_t> qin (chunk*src->nb[1]);
+            std::vector<float>   f32 (chunk*n_per_row);
+            std::vector<uint8_t> qout(chunk*t->nb[1]);
+            for (;;) {
+                const int64_t r0 = next.fetch_add(chunk);
+                if (r0 >= n_rows) {
+                    break;
+                }
+                const int64_t nr = std::min(chunk, n_rows - r0);
+                {
+                    std::lock_guard<std::mutex> lk(mtx);
+                    ggml_backend_tensor_get(src, qin.data(), r0*src->nb[1], nr*src->nb[1]);
+                }
+                tr_src->to_float(qin.data(), f32.data(), nr*n_per_row);
+                ggml_quantize_chunk(type, f32.data(), qout.data(), 0, nr, n_per_row, nullptr);
+                {
+                    std::lock_guard<std::mutex> lk(mtx);
+                    ggml_backend_tensor_set(t, qout.data(), r0*t->nb[1], nr*t->nb[1]);
+                }
+            }
+        });
+    }
+    for (auto & w : workers) {
+        w.join();
+    }
+
+    std::vector<ggml_backend_buffer_ptr> bufs;
+    bufs.emplace_back(buf);
+    keep.emplace_back(ggml_context_ptr(ctx), std::move(bufs));
+    return t;
+}
+
 bool llama_model_base::load_tensors(llama_model_loader & ml) {
     const auto & split_mode   = params.split_mode;
     const bool use_mlock      = params.load_mode == LLAMA_LOAD_MODE_MLOCK || params.load_mode == LLAMA_LOAD_MODE_MMAP_MLOCK;
@@ -1985,6 +2050,24 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         }
     }
 
+    // draft-only coarse LM head for qwen4exp MTP drafting (the MTP sidecar carries a Q8_0 head)
+    if (arch == LLM_ARCH_QWEN4EXP && output && output->type == GGML_TYPE_Q8_0) {
+        const char * env = getenv("LLAMA_MTP_COARSE_HEAD");
+        const std::string want = env ? env : "q2_K";
+        ggml_type type = GGML_TYPE_COUNT;
+        if (want == "q2_K") type = GGML_TYPE_Q2_K;
+        if (want == "q3_K") type = GGML_TYPE_Q3_K;
+        if (want == "q4_K") type = GGML_TYPE_Q4_K;
+        if (type != GGML_TYPE_COUNT) {
+            const int64_t t0 = ggml_time_us();
+            output_coarse = llama_requantize_copy(output, type, "output_coarse", pimpl->ctxs_bufs);
+            if (output_coarse) {
+                LLAMA_LOG_INFO("%s: draft coarse head %s (%.1f MiB) built in %.1f s\n", __func__,
+                        ggml_type_name(type), ggml_nbytes(output_coarse)/1048576.0, (ggml_time_us() - t0)/1e6);
+            }
+        }
+    }
+
     return true;
 }
 
