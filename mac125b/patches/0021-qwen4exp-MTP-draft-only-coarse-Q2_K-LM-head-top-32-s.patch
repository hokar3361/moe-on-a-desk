     struct ggml_tensor * output_res_score = nullptr; // kimi-k3: final cross-layer residual mix
     struct ggml_tensor * output_norm_b   = nullptr;
     struct ggml_tensor * output          = nullptr;
+    struct ggml_tensor * output_coarse   = nullptr; // draft-only low-bit copy of output (MTP drafting)
     struct ggml_tensor * output_b        = nullptr;
     struct ggml_tensor * output_norm_enc = nullptr;
 
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index d9687b6..42d5e01 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -519,7 +519,20 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
     cb(cur, "result_norm", -1);
     res->t_embd = cur;
 
-    cur = build_lora_mm(model.output, cur, model.output_s);
+    if (model.output_coarse && cur->ne[1] == 1 && !model.output_s) {
+        // draft readout: coarse full-vocab head -> top-32 -> exact re-score with the real head rows;
+        // every other logit is -inf. The verify pass of the target is unaffected.
+        const int64_t n_vocab = model.output->ne[1];
+        ggml_tensor * coarse = ggml_mul_mat(ctx0, model.output_coarse, cur);          // [n_vocab, 1]
+        ggml_tensor * idx    = ggml_top_k(ctx0, coarse, 32);                          // [32, 1]
+        ggml_tensor * rows   = ggml_get_rows(ctx0, model.output, idx);                // [n_embd, 32]
+        ggml_tensor * exact  = ggml_mul_mat(ctx0, rows, cur);                         // [32, 1]
+        ggml_tensor * full   = ggml_fill(ctx0, coarse, -INFINITY);                    // [n_vocab, 1]
+        full = ggml_set_rows(ctx0, ggml_reshape_2d(ctx0, full, 1, n_vocab), ggml_reshape_2d(ctx0, exact, 1, 32), idx);
+        cur  = ggml_reshape_2d(ctx0, full, n_vocab, 1);
+    } else {
+        cur = build_lora_mm(model.output, cur, model.output_s);
+    }
     cb(cur, "result_output", -1);
     res->t_logits = cur;
 
@@ -615,7 +628,20 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
     cb(cur, "result_norm", -1);
     res->t_embd = cur;
 
-    cur = build_lora_mm(model.output, cur, model.output_s);
+    if (model.output_coarse && cur->ne[1] == 1 && !model.output_s) {
+        // draft readout: coarse full-vocab head -> top-32 -> exact re-score with the real head rows;
+        // every other logit is -inf. The verify pass of the target is unaffected.
+        const int64_t n_vocab = model.output->ne[1];
+        ggml_tensor * coarse = ggml_mul_mat(ctx0, model.output_coarse, cur);          // [n_vocab, 1]
+        ggml_tensor * idx    = ggml_top_k(ctx0, coarse, 32);                          // [32, 1]
+        ggml_tensor * rows   = ggml_get_rows(ctx0, model.output, idx);                // [n_embd, 32]
+        ggml_tensor * exact  = ggml_mul_mat(ctx0, rows, cur);                         // [32, 1]
+        ggml_tensor * full   = ggml_fill(ctx0, coarse, -INFINITY);                    // [n_vocab, 1]
+        full = ggml_set_rows(ctx0, ggml_reshape_2d(ctx0, full, 1, n_vocab), ggml_reshape_2d(ctx0, exact, 1, 32), idx);
+        cur  = ggml_reshape_2d(ctx0, full, n_vocab, 1);
+    } else {
+        cur = build_lora_mm(model.output, cur, model.output_s);
+    }
     cb(cur, "result_output", -1);
     res->t_logits = cur;
 
