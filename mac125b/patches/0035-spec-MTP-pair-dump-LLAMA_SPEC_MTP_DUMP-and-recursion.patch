+            LOG_INF("%s: MTP recursion adapter %s: %s (rank %d)\n", __func__, ap, use_adapter ? "loaded" : "FAILED", adapter.r);
+        }
         merge = getenv("LLAMA_SPEC_MTP_MERGE") && atoi(getenv("LLAMA_SPEC_MTP_MERGE")) != 0 && !chain_heads && !is_mem_shared;
         gen.assign(n_seq, false);
         def_valid.assign(n_seq, false);
@@ -1897,6 +1967,24 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
             if (!ok) {
                 return false;
             }
+
+            if (dump_f && n_tokens > 16) {
+                const int64_t ne = (int64_t) n_embd;
+                std::vector<ggml_fp16_t> buf(2*ne);
+                for (int k = 0; k < n_tokens; ++k) {
+                    const float * hm = llama_get_embeddings_nextn_ith(ctx_dft, k);
+                    const float * ht = llama_get_embeddings_nextn_ith(ctx_tgt, k);
+                    if (!hm || !ht || batch_in.tokens[k].id == LLAMA_TOKEN_NULL) {
+                        continue;
+                    }
+                    ggml_fp32_to_fp16_row(hm, buf.data(), ne);
+                    ggml_fp32_to_fp16_row(ht, buf.data() + ne, ne);
+                    const int32_t tok = batch_in.tokens[k].id;
+                    fwrite(&tok, sizeof(tok), 1, dump_f);
+                    fwrite(buf.data(), sizeof(ggml_fp16_t), 2*ne, dump_f);
+                }
+                fflush(dump_f);
+            }
         }
 
         for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
@@ -2233,7 +2321,12 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
                     i_last[seq_id] = idx;
                 } else {
                     const int32_t idx = batch.add(id, dp.pos0 + i + 1, seq_id, true);
-                    batch.set_embd_state(idx, { h_row, 1, (size_t) n_embd });
+                    const float * h_next = h_row;
+                    if (use_adapter) {
+                        adapter.apply(h_row, h_adapt[seq_id].data());
+                        h_next = h_adapt[seq_id].data();
+                    }
+                    batch.set_embd_state(idx, { h_next, 1, (size_t) n_embd });
                     i_last[seq_id] = idx;
                 }
             }
