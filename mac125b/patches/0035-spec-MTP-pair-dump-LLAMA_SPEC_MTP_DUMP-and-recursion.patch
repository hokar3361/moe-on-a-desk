     }
 };
 
+
+#include <dlfcn.h>
+// recursion adapter for chained MTP draft steps (LLAMA_SPEC_MTP_ADAPTER)
+struct mtp_adapter {
+    int ne = 0, r = 0, n_streams = 4;
+    std::vector<float> mx, b, W, U, V, xc, t, y;
+    typedef void (*sgemv_t)(int, int, int, int, float, const float *, int, const float *, int, float, float *, int);
+    sgemv_t sgemv = nullptr;
+
+    bool load(const char * path, int n_embd_out) {
+        FILE * f = fopen(path, "rb");
+        if (!f) return false;
+        int32_t hdr[2];
+        if (fread(hdr, 4, 2, f) != 2 || hdr[0] != n_embd_out) { fclose(f); return false; }
+        ne = hdr[0]; r = hdr[1];
+        mx.resize(ne); b.resize(ne);
+        bool ok = fread(mx.data(), 4, ne, f) == (size_t) ne && fread(b.data(), 4, ne, f) == (size_t) ne;
+        if (r == 0) {
+            W.resize((size_t) ne*ne);
+            ok = ok && fread(W.data(), 4, W.size(), f) == W.size();
+        } else {
+            U.resize((size_t) ne*r); V.resize((size_t) r*ne);
+            ok = ok && fread(U.data(), 4, U.size(), f) == U.size() && fread(V.data(), 4, V.size(), f) == V.size();
+        }
+        fclose(f);
+        void * h = dlopen("/System/Library/Frameworks/Accelerate.framework/Accelerate", RTLD_LAZY);
+        sgemv = h ? (sgemv_t) dlsym(h, "cblas_sgemv") : nullptr;
+        xc.resize(ne); y.resize(ne); t.resize(std::max(r, 1));
+        return ok && sgemv;
+    }
+
+    // in: MTP output residual (ne floats); out: adapted h
+    void apply(const float * in, float * out) {
+        const int ns = ne/n_streams;
+        for (int s = 0; s < n_streams; ++s) {
+            double ss = 0.0;
+            for (int i = 0; i < ns; ++i) ss += (double) in[s*ns + i]*in[s*ns + i];
+            const float sc = 1.0f/sqrtf((float) (ss/ns) + 1e-6f);
+            for (int i = 0; i < ns; ++i) {
+                out[s*ns + i] = in[s*ns + i]*sc;
+                xc[s*ns + i]  = out[s*ns + i] - mx[s*ns + i];
+            }
+        }
+        const int RowMajor = 101, Trans = 112;
+        if (r == 0) {
+            sgemv(RowMajor, Trans, ne, ne, 1.0f, W.data(), ne, xc.data(), 1, 0.0f, y.data(), 1);
+        } else {
+            sgemv(RowMajor, Trans, ne, r, 1.0f, U.data(), r, xc.data(), 1, 0.0f, t.data(), 1);
+            sgemv(RowMajor, Trans, r, ne, 1.0f, V.data(), ne, t.data(), 1, 0.0f, y.data(), 1);
+        }
+        for (int i = 0; i < ne; ++i) out[i] += y[i] + b[i];
+    }
+};
+
 struct common_speculative_impl_draft_mtp : public common_speculative_impl {
     common_params_speculative_draft params; // reuses the draft-model params slot (ctx_tgt/ctx_dft)
 
