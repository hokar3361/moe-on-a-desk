From: mac125b <mac125b@example.invalid>
Date: Sat, 10 Oct 2026 22:41:12 +0900
Subject: [PATCH 13/49] metal: GGML_METAL_PROF_DEPTH data-flow depth report

---
 ggml/src/ggml-metal/ggml-metal-context.m |  6 ++++
 ggml/src/ggml-metal/ggml-metal-ops.cpp   | 44 ++++++++++++++++++++++++
 2 files changed, 50 insertions(+)

diff --git a/ggml/src/ggml-metal/ggml-metal-context.m b/ggml/src/ggml-metal/ggml-metal-context.m
index fb1e3bc..1cd50c3 100644
--- a/ggml/src/ggml-metal/ggml-metal-context.m
+++ b/ggml/src/ggml-metal/ggml-metal-context.m
@@ -533,7 +533,13 @@ bool ggml_metal_cpy_tensor_async(ggml_metal_t ctx_src, ggml_metal_t ctx_dst, con
     }
 }
 
+void ggml_metal_graph_depth_report(const struct ggml_cgraph * gf);
+
 enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph * gf) {
+    if (getenv("GGML_METAL_PROF_DEPTH")) {
+        ggml_metal_graph_depth_report(gf);
+    }
+
     if (ctx->has_error) {
         GGML_LOG_ERROR("%s: backend is in error state from a previous command buffer failure - recreate the backend to recover\n", __func__);
         return GGML_STATUS_FAILED;
diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 3729bac..e18fc29 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -12,6 +12,8 @@
 
 #include <cassert>
 #include <string>
+#include <unordered_map>
+#include <vector>
 #include <algorithm>
 #include <limits>
 #include <cmath>
@@ -153,6 +155,48 @@ void ggml_metal_op_free(ggml_metal_op_t ctx) {
     delete ctx;
 }
 
+// profiling (GGML_METAL_PROF_DEPTH): longest data-flow chain of compute nodes in the graph,
+// i.e. the fewest barrier-separated stages any schedule could reach (memory reuse hazards ignored)
+extern "C" void ggml_metal_graph_depth_report(const ggml_cgraph * gf) {
+    static std::vector<int> seen;
+    for (int n : seen) {
+        if (n == gf->n_nodes) {
+            return;
+        }
+    }
+    seen.push_back(gf->n_nodes);
+
+    std::unordered_map<const ggml_tensor *, int> lvl;
+    int depth = 0, n_compute = 0;
+    std::vector<int> width;
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        const ggml_tensor * t = gf->nodes[i];
+        int l = 0;
+        for (int s2 = 0; s2 < GGML_MAX_SRC; ++s2) {
+            if (t->src[s2]) {
+                auto it = lvl.find(t->src[s2]);
+                if (it != lvl.end()) l = std::max(l, it->second);
+            }
+        }
+        if (t->view_src) {
+            auto it = lvl.find(t->view_src);
+            if (it != lvl.end()) l = std::max(l, it->second);
+        }
+        if (!ggml_op_is_empty(t->op) && !ggml_is_empty(t)) {
+            l += 1;
+            n_compute++;
+            if ((int) width.size() <= l) width.resize(l + 1, 0);
+            width[l]++;
+        }
+        lvl[t] = l;
+        depth = std::max(depth, l);
+    }
+    int w1 = 0;
+    for (int w : width) w1 += w == 1;
+    fprintf(stderr, "graph-depth: nodes=%d compute=%d data-flow depth=%d (levels with a single node: %d)\n",
+            gf->n_nodes, n_compute, depth, w1);
+}
+
 int ggml_metal_op_n_nodes(ggml_metal_op_t ctx) {
     return ctx->n_nodes();
 }
