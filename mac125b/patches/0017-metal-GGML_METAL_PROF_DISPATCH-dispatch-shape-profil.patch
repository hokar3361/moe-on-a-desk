From 4ff6e89c30848093b2e2ee19d24428f58c73bf3b Mon Sep 17 00:00:00 2001
From: mac125b <mac125b@example.invalid>
Date: Sat, 10 Oct 2026 22:50:33 +0900
Subject: [PATCH 17/49] metal: GGML_METAL_PROF_DISPATCH dispatch-shape
 profiling

---
 ggml/src/ggml-metal/ggml-metal-context.m |  1 +
 ggml/src/ggml-metal/ggml-metal-device.h  |  2 +
 ggml/src/ggml-metal/ggml-metal-device.m  | 48 ++++++++++++++++++++++++
 ggml/src/ggml-metal/ggml-metal-ops.cpp   |  2 +
 4 files changed, 53 insertions(+)

diff --git a/ggml/src/ggml-metal/ggml-metal-context.m b/ggml/src/ggml-metal/ggml-metal-context.m
index 1cd50c3..44b6408 100644
--- a/ggml/src/ggml-metal/ggml-metal-context.m
+++ b/ggml/src/ggml-metal/ggml-metal-context.m
@@ -539,6 +539,7 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
     if (getenv("GGML_METAL_PROF_DEPTH")) {
         ggml_metal_graph_depth_report(gf);
     }
+    ggml_metal_prof_dispatch_graph();
 
     if (ctx->has_error) {
         GGML_LOG_ERROR("%s: backend is in error state from a previous command buffer failure - recreate the backend to recover\n", __func__);
diff --git a/ggml/src/ggml-metal/ggml-metal-device.h b/ggml/src/ggml-metal/ggml-metal-device.h
index 9fe5ecc..7910c70 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.h
+++ b/ggml/src/ggml-metal/ggml-metal-device.h
@@ -358,6 +358,8 @@ bool ggml_metal_prof_ids_enabled(void);
 int  ggml_metal_prof_ids_alloc(int n_tok, int n_used); // returns int32 offset into the snapshot area, -1 if full
 void ggml_metal_prof_ids_flush(ggml_metal_device_t dev);
 uint32_t                    ggml_metal_device_get_sync_error (ggml_metal_device_t dev);
+void ggml_metal_prof_dispatch_set_op(const char * op);
+void ggml_metal_prof_dispatch_graph(void);
 
 struct ggml_metal_fusion_info;
 
diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index 54d47bf..2468d57 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -889,7 +889,55 @@ void ggml_metal_encoder_set_threadgroup_memory_size(ggml_metal_encoder_t encoder
     [encoder->obj setThreadgroupMemoryLength:size atIndex:idx];
 }
 
+#define PROF_DISP_MAX 512
+static struct { char op[48]; int tpt; uint64_t n, tgs; } g_disp[PROF_DISP_MAX];
+static int g_disp_n = 0;
+static const char * g_disp_op = "?";
+static uint64_t g_disp_graphs = 0;
+static int g_disp_en = -1;
+
+static void ggml_metal_prof_dispatch_report(void) {
+    fprintf(stderr, "prof-dispatch: per graph (graphs=%llu)\n", (unsigned long long) g_disp_graphs);
+    for (int i = 0; i < g_disp_n; ++i) {
+        const double g = g_disp_graphs ? (double) g_disp_graphs : 1.0;
+        fprintf(stderr, "prof-dispatch: %-24s tpt=%5d dispatches=%8.1f threadgroups=%10.1f avg_tg=%8.1f\n",
+                g_disp[i].op, g_disp[i].tpt, g_disp[i].n/g, g_disp[i].tgs/g, (double) g_disp[i].tgs/g_disp[i].n);
+    }
+}
+
+static bool ggml_metal_prof_dispatch_enabled(void) {
+    if (g_disp_en < 0) {
+        g_disp_en = getenv("GGML_METAL_PROF_DISPATCH") != NULL;
+        if (g_disp_en) atexit(ggml_metal_prof_dispatch_report);
+    }
+    return g_disp_en;
+}
+
+void ggml_metal_prof_dispatch_set_op(const char * op) {
+    g_disp_op = op;
+}
+
+void ggml_metal_prof_dispatch_graph(void) {
+    if (ggml_metal_prof_dispatch_enabled()) g_disp_graphs++;
+}
+
 void ggml_metal_encoder_dispatch_threadgroups(ggml_metal_encoder_t encoder, int tg0, int tg1, int tg2, int tptg0, int tptg1, int tptg2) {
+    if (ggml_metal_prof_dispatch_enabled()) {
+        const int tpt = tptg0*tptg1*tptg2;
+        int k = 0;
+        for (; k < g_disp_n; ++k) {
+            if (g_disp[k].tpt == tpt && !strcmp(g_disp[k].op, g_disp_op)) break;
+        }
+        if (k == g_disp_n && g_disp_n < PROF_DISP_MAX) {
+            snprintf(g_disp[k].op, sizeof(g_disp[k].op), "%s", g_disp_op);
+            g_disp[k].tpt = tpt; g_disp[k].n = 0; g_disp[k].tgs = 0;
+            g_disp_n++;
+        }
+        if (k < PROF_DISP_MAX) {
+            g_disp[k].n++;
+            g_disp[k].tgs += (uint64_t) tg0*tg1*tg2;
+        }
+    }
     [encoder->obj dispatchThreadgroups:MTLSizeMake(tg0, tg1, tg2) threadsPerThreadgroup:MTLSizeMake(tptg0, tptg1, tptg2)];
 }
 
diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 0a6441c..cc69ab4 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -288,6 +288,8 @@ static int ggml_metal_op_encode_impl(ggml_metal_op_t ctx, int idx) {
         return 1;
     }
 
+    ggml_metal_prof_dispatch_set_op(ggml_op_desc(node));
+
     int n_fuse = 1;
 
     // check if the current node can run concurrently with other nodes before it
-- 
