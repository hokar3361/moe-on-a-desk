+        if (mmvf_max > 0 && GGML_CUDA_CC_IS_NVIDIA(cc) && (type == GGML_TYPE_F16 || type == GGML_TYPE_BF16)) {
+            return ne11 <= std::min(mmvf_max, MMVF_MAX_BATCH_SIZE);
