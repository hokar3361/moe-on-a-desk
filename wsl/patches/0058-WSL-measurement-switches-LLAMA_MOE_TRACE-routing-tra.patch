Subject: [PATCH 58/58] WSL: measurement switches (LLAMA_MOE_TRACE routing
 trace, GGML_MOE_FETCH_FIXED / GGML_MOE_FETCH_NOCOPY, GGML_CUDA_SKIP),
 MOE_FETCH log, opt-in GGML_CUDA_MMVF_MAX for F16/BF16 matmuls

---
 ggml/src/ggml-cuda/ggml-cuda.cu | 29 +++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/mmvf.cu      |  7 +++++++
 ggml/src/ggml-cuda/moe-fetch.cu | 14 +++++++++-----
 src/llama-moe-cache.cpp         | 22 ++++++++++++++++++++++
 4 files changed, 67 insertions(+), 5 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index ce8431e35..547a2f9cf 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2171,7 +2171,36 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
         nb1, nb2, nb3, stream);
 }
 
+static bool ggml_cuda_skip_node(const ggml_tensor * dst) {
+    static std::vector<std::string> pats = [] {
+        std::vector<std::string> v;
+        const char * e = getenv("GGML_CUDA_SKIP");
+        if (e) {
+            std::string s = e, cur;
+            for (char c : s) { if (c == ',') { if (!cur.empty()) v.push_back(cur); cur.clear(); } else cur += c; }
+            if (!cur.empty()) v.push_back(cur);
+        }
+        return v;
+    }();
+    if (pats.empty() || dst->op == GGML_OP_MOE_FETCH) {
+        return false;
+    }
+    for (const auto & p : pats) {
+        std::string op = p, ty, nm;
+        const size_t a = op.find('@'); if (a != std::string::npos) { nm = op.substr(a + 1); op = op.substr(0, a); }
+        const size_t b = op.find(':'); if (b != std::string::npos) { ty = op.substr(b + 1); op = op.substr(0, b); }
+        if (op != ggml_op_name(dst->op)) continue;
+        if (!ty.empty() && (!dst->src[0] || ty != ggml_type_name(dst->src[0]->type))) continue;
+        if (!nm.empty() && std::string(dst->name).find(nm) == std::string::npos) continue;
+        return true;
+    }
+    return false;
+}
+
 static bool ggml_cuda_compute_forward(ggml_backend_cuda_context & ctx, struct ggml_tensor * dst) {
+    if (ggml_cuda_skip_node(dst)) {
+        return true;
+    }
     switch (dst->op) {
         case GGML_OP_ARGMAX:
             ggml_cuda_argmax(ctx, dst);
