+            n_expert, n_trace, tbase, n_trans, (int32_t *) dst->data, getenv("GGML_MOE_FETCH_FIXED") != nullptr);
     CUDA_CHECK(cudaGetLastError());
 
+    static const bool nocopy = getenv("GGML_MOE_FETCH_NOCOPY") != nullptr; // measurement only: wrong outputs
