diff --git a/ggml/src/ggml-cuda/moe-fetch.cu b/ggml/src/ggml-cuda/moe-fetch.cu
new file mode 100644
index 000000000..07e6d1313
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-fetch.cu
@@ -0,0 +1,147 @@
+#include "moe-fetch.cuh"
+
+// GPU side of the MoE expert cache (fork): see ggml_moe_fetch in ggml.h.
+// Plan (one block): the first id of each distinct expert owns it; owners look up the slot map, take a slot from the free pool of the
+// group for a miss (or a transient slot when the pool is empty), and append to the trace and to the miss list.
+// Copy: FETCH_COPY_BLOCKS blocks stride over all the bytes of all the misses (zero-copy reads of the page-locked host experts peak at
+// a small grid); the expert sizes are multiples of 16 bytes for the types this is used with, the tail is copied bytewise anyway.
+
+#define MOE_FETCH_NEW   (1 << 30)
+#define MOE_FETCH_TRANS (1 << 29)
+#define FETCH_COPY_BLOCKS 12
+
+static __global__ void k_moe_fetch_plan(const int32_t * __restrict__ ids, const int n_ids, int32_t * __restrict__ st,
+        int32_t * __restrict__ pool, const int n_expert, const int n_trace, const int tbase, const int n_trans, int32_t * __restrict__ out) {
+    extern __shared__ int32_t owner[]; // [n_expert]: smallest index of the ids that select the expert, then -2 - slot
+    __shared__ int s_nt, s_nm, s_tr;
+
+    int32_t * map   = st;
+    int32_t * p_nt  = st + n_expert;
+    int32_t * trace = p_nt + 1;
+    int32_t * p_nm  = trace + 2*n_trace;
+    int32_t * miss  = p_nm + 1;
+
+    for (int e = threadIdx.x; e < n_expert; e += blockDim.x) {
+        owner[e] = 0x7fffffff;
+    }
+    if (threadIdx.x == 0) {
+        s_nt = 0;
+        s_nm = 0;
+        s_tr = 0;
+    }
+    __syncthreads();
+    for (int i = threadIdx.x; i < n_ids; i += blockDim.x) {
+        atomicMin(&owner[ids[i]], i);
+    }
+    __syncthreads();
+
+    for (int i = threadIdx.x; i < n_ids; i += blockDim.x) {
+        const int e = ids[i];
+        if (owner[e] != i) {
+            continue;
+        }
+        int s    = map[e];
+        int flag = 0;
+        if (s < 0) {
+            const int f = atomicSub(&pool[0], 1) - 1;
+            if (f >= 0) {
+                s      = pool[1 + f];
+                map[e] = s;
+                flag   = MOE_FETCH_NEW;
+            } else {
+                const int t = atomicAdd(&s_tr, 1);
+                s    = tbase + min(t, n_trans - 1);
+                flag = MOE_FETCH_TRANS;
+            }
+            const int m = atomicAdd(&s_nm, 1);
+            if (m < n_trace) {
+                miss[2*m + 0] = e;
+                miss[2*m + 1] = s;
+            }
+        }
+        const int t = atomicAdd(&s_nt, 1);
+        if (t < n_trace) {
+            trace[2*t + 0] = e;
+            trace[2*t + 1] = s | flag;
+        }
+        owner[e] = -2 - s;
+    }
+    __syncthreads();
+
+    for (int i = threadIdx.x; i < n_ids; i += blockDim.x) {
+        out[i] = -2 - owner[ids[i]];
+    }
+    if (threadIdx.x == 0) {
+        *p_nt = min(s_nt, n_trace);
+        *p_nm = min(s_nm, n_trace);
+        if (pool[0] < 0) {
+            pool[0] = 0;
+        }
+    }
+}
+
+static __global__ void k_moe_fetch_copy(const int32_t * __restrict__ p_nm, const int64_t * __restrict__ desc) {
+    const int n_miss = p_nm[0];
+    if (n_miss == 0) {
+        return;
+    }
+    const int32_t * miss = p_nm + 1;
+    const int n_w = (int) desc[0];
+    // the 16-byte units of one expert over all its tensors
+    int64_t per = 0;
+    for (int w = 0; w < n_w; ++w) {
+        per += desc[2 + 3*w] / 16;
+    }
+    const int64_t total = per*n_miss;
+    for (int64_t u = (int64_t) blockIdx.x*blockDim.x + threadIdx.x; u < total; u += (int64_t) gridDim.x*blockDim.x) {
+        const int     m = (int) (u / per);
+        int64_t       r = u - (int64_t) m*per;
+        int           w = 0;
+        while (r >= desc[2 + 3*w] / 16) {
+            r -= desc[2 + 3*w] / 16;
+            w++;
+        }
+        const int64_t size = desc[2 + 3*w];
+        const uint4 * src = (const uint4 *) ((const uint8_t *) desc[1 + 3*w] + (int64_t) miss[2*m + 0]*size);
+        uint4       * dst = (uint4 *)       ((uint8_t *)       desc[3 + 3*w] + (int64_t) miss[2*m + 1]*size);
+        dst[r] = src[r];
+    }
+    // tails (sizes not a multiple of 16)
+    if (blockIdx.x == 0) {
+        for (int m = 0; m < n_miss; ++m) {
+            for (int w = 0; w < n_w; ++w) {
+                const int64_t size = desc[2 + 3*w];
+                const uint8_t * src = (const uint8_t *) desc[1 + 3*w] + (int64_t) miss[2*m + 0]*size;
+                uint8_t       * dst = (uint8_t *)       desc[3 + 3*w] + (int64_t) miss[2*m + 1]*size;
+                for (int64_t i = (size/16)*16 + threadIdx.x; i < size; i += blockDim.x) {
+                    dst[i] = src[i];
+                }
+            }
+        }
+    }
+}
+
+void ggml_cuda_op_moe_fetch(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * ids   = dst->src[0];
+    ggml_tensor       * state = dst->src[1];
+    const ggml_tensor * desc  = dst->src[2];
+    ggml_tensor       * pool  = dst->src[3];
+
+    const int32_t * p = (const int32_t *) dst->op_params;
+    const int n_expert = p[0];
+    const int n_trace  = p[1];
+    const int tbase    = p[2];
+    const int n_trans  = p[3];
+
+    const int n_ids = (int) ggml_nelements(ids);
+    cudaStream_t stream = ctx.stream();
+
+    int32_t * st = (int32_t *) state->data;
+    k_moe_fetch_plan<<<1, 256, n_expert*sizeof(int32_t), stream>>>((const int32_t *) ids->data, n_ids, st, (int32_t *) pool->data,
+            n_expert, n_trace, tbase, n_trans, (int32_t *) dst->data);
+    CUDA_CHECK(cudaGetLastError());
+
+    const int32_t * p_nm = st + n_expert + 1 + 2*n_trace;
+    k_moe_fetch_copy<<<FETCH_COPY_BLOCKS, 256, 0, stream>>>(p_nm, (const int64_t *) desc->data);
+    CUDA_CHECK(cudaGetLastError());
+}
