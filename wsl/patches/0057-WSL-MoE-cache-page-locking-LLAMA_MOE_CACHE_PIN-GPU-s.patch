+// ---- GGML_CUDA_OPPROF (profiling) ----
+#include <map>
+#include <string>
+static int ggml_cuda_opprof_every() {
+    static const int v = getenv("GGML_CUDA_OPPROF") ? atoi(getenv("GGML_CUDA_OPPROF")) : 0;
+    return v;
+}
+struct ggml_cuda_opprof_state {
+    std::vector<cudaEvent_t> ev;
+    std::vector<std::string> label;
+    std::map<std::string, std::pair<double, int64_t>> acc;
+    int n_graphs = 0;
+    double total = 0.0;
+    int n_marks = 0;
+    bool active = false;
+};
+static ggml_cuda_opprof_state & ggml_cuda_opprof() { static ggml_cuda_opprof_state st; return st; }
+static void ggml_cuda_opprof_mark(cudaStream_t stream, const ggml_tensor * node) {
+    auto & st = ggml_cuda_opprof();
+    if (!st.active) return;
+    if ((int) st.ev.size() <= st.n_marks) {
+        cudaEvent_t e; CUDA_CHECK(cudaEventCreate(&e)); st.ev.push_back(e); st.label.emplace_back();
+    }
+    std::string name = node ? node->name : "end";
+    while (!name.empty() && (isdigit((unsigned char) name.back()))) name.pop_back();
+    if (!name.empty() && name.back() == '-') name.pop_back();
+    std::string lab = node ? std::string(ggml_op_name(node->op)) : "end";
+    if (node && (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) && node->src[0]) {
+        lab += std::string("[") + ggml_type_name(node->src[0]->type) + "]";
+    }
+    if (node && node->op == GGML_OP_UNARY) lab += std::string("[") + ggml_unary_op_name(ggml_get_unary_op(node)) + "]";
+    if (node && node->op == GGML_OP_GLU) lab += std::string("[") + ggml_glu_op_name(ggml_get_glu_op(node)) + "]";
+    lab += " " + name + " B" + std::to_string(node ? node->ne[1] : 0);
+    st.label[st.n_marks] = lab;
+    CUDA_CHECK(cudaEventRecord(st.ev[st.n_marks], stream));
+    st.n_marks++;
+}
+static void ggml_cuda_opprof_begin(const ggml_cgraph * cgraph, cudaStream_t stream) {
+    auto & st = ggml_cuda_opprof();
+    cudaStreamCaptureStatus cs = cudaStreamCaptureStatusNone;
+    CUDA_CHECK(cudaStreamIsCapturing(stream, &cs));
+    st.active = ggml_cuda_opprof_every() > 0 && cgraph->n_nodes > 20 && cs == cudaStreamCaptureStatusNone;
+    st.n_marks = 0;
+}
+static void ggml_cuda_opprof_end(cudaStream_t stream) {
+    auto & st = ggml_cuda_opprof();
+    if (!st.active) return;
+    ggml_cuda_opprof_mark(stream, nullptr);
+    CUDA_CHECK(cudaEventSynchronize(st.ev[st.n_marks - 1]));
+    double tot = 0;
+    for (int i = 0; i + 1 < st.n_marks; ++i) {
+        float ms = 0; CUDA_CHECK(cudaEventElapsedTime(&ms, st.ev[i], st.ev[i + 1]));
+        auto & a = st.acc[st.label[i]]; a.first += ms; a.second += 1; tot += ms;
+    }
+    st.total += tot;
+    {
+        static int dumped = 0;
+        if (dumped < 3 && getenv("GGML_CUDA_OPPROF_DUMP") && st.n_marks > 50 && st.label[0].find(" B4") != std::string::npos) {
+            dumped++;
+            for (int i = 0; i + 1 < st.n_marks; ++i) {
+                float ms = 0; CUDA_CHECK(cudaEventElapsedTime(&ms, st.ev[i], st.ev[i + 1]));
+                fprintf(stderr, "cuda-dump %d: %3d %7.1f us  %s\n", dumped, i, ms*1000, st.label[i].c_str());
+            }
+        }
+    }
+    { static double marks = 0; static int ng = 0; marks += st.n_marks - 1; if (++ng % ggml_cuda_opprof_every() == 0) { fprintf(stderr, "cuda-opprof: kernels per graph %.1f\n", marks/ng); marks = 0; ng = 0; } }
+    st.active = false;
+    if (++st.n_graphs % ggml_cuda_opprof_every() == 0) {
+        std::vector<std::pair<double, std::string>> v;
+        for (auto & kv : st.acc) v.push_back({kv.second.first, kv.first});
+        std::sort(v.rbegin(), v.rend());
+        const int n = st.n_graphs;
+        fprintf(stderr, "cuda-opprof: %d graphs, GPU %.3f ms per graph\n", n, st.total/n);
+        for (size_t i = 0; i < v.size() && i < 40; ++i) {
+            fprintf(stderr, "cuda-opprof: %7.3f ms %5.1f%% %6.1f/graph  %s\n", v[i].first/n, 100*v[i].first/st.total, (double) st.acc[v[i].second].second/n, v[i].second.c_str());
+        }
+        st.acc.clear(); st.total = 0; st.n_graphs = 0;
+    }
+}
+// ---- end GGML_CUDA_OPPROF ----
+
+// ---- GGML_CUDA_GPROF (profiling with the CUDA graphs on) ----
+static int ggml_cuda_gprof_every() {
+    static const int v = getenv("GGML_CUDA_GPROF") ? atoi(getenv("GGML_CUDA_GPROF")) : 0;
+    return v;
+}
+struct ggml_cuda_gprof_graph {
+    std::vector<cudaEvent_t> ev;
+    std::vector<std::string> label;
+    int n = 0;
+};
+struct ggml_cuda_gprof_state {
+    std::unordered_map<const void *, ggml_cuda_gprof_graph> graphs;
+    ggml_cuda_gprof_graph * capturing = nullptr;
+    std::map<std::string, std::pair<double, int64_t>> acc;
+    double total = 0.0;
+    int64_t n_launch = 0, n_kernels = 0;
+};
+static ggml_cuda_gprof_state & ggml_cuda_gprof() { static ggml_cuda_gprof_state st; return st; }
+static std::string ggml_cuda_gprof_label(const ggml_tensor * node) {
+    if (!node) return "end";
+    std::string name = node->name;
+    while (!name.empty() && isdigit((unsigned char) name.back())) name.pop_back();
+    if (!name.empty() && name.back() == '-') name.pop_back();
+    std::string lab = ggml_op_name(node->op);
+    if ((node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) && node->src[0]) {
+        lab += std::string("[") + ggml_type_name(node->src[0]->type) + " " + std::to_string(node->src[0]->ne[0]) + "x" + std::to_string(node->src[0]->ne[1]) + "]";
+    }
+    if (node->op == GGML_OP_UNARY) lab += std::string("[") + ggml_unary_op_name(ggml_get_unary_op(node)) + "]";
+    if (node->op == GGML_OP_GLU) lab += std::string("[") + ggml_glu_op_name(ggml_get_glu_op(node)) + "]";
+    return lab + " " + name + " B" + std::to_string(node->ne[1]);
+}
+static void ggml_cuda_gprof_capture_begin(const void * key) {
+    auto & st = ggml_cuda_gprof();
+    st.capturing = &st.graphs[key];
+    st.capturing->n = 0;
+}
+static const char * ggml_cuda_gprof_section(const ggml_tensor * node) {
+    const std::string nm = node->name;
+    auto has = [&](const char * x) { return nm.find(x) != std::string::npos; };
+    if (has("ffn_moe")) return "moe";
+    if (has("shexp") || has("shared_expert") || has("ffn_gate") || has("ffn_up") || has("ffn_swiglu") || has("ffn_out")) return "shexp";
+    if (has("hc_") || node->op == GGML_OP_DSV4_HC_PRE || node->op == GGML_OP_DSV4_HC_POST) return "hc";
+    if (node->op == GGML_OP_GATED_DELTA_NET || node->op == GGML_OP_SSM_CONV || has("conv") || has("linear_attn") || has("beta") ||
+        has("softplus") || has("cache_r") || has("z-") || nm == "z" || has("gate")) return "gdn";
+    if (node->op == GGML_OP_FLASH_ATTN_EXT || node->op == GGML_OP_ROPE || node->op == GGML_OP_TOP_K || has("indexer") || has("cur") ||
+        has("attn") || has("kq") || has("kpool")) return "attn";
