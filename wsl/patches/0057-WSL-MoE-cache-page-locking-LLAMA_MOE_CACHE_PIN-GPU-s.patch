+static void ggml_cuda_gprof_mark(cudaStream_t stream, const ggml_tensor * node) {
+    auto & st = ggml_cuda_gprof();
+    auto * g = st.capturing;
+    if (!g) return;
+    static const bool sect = getenv("GGML_CUDA_GPROF_SECT") != nullptr;
+    if (sect) {
+        static std::string cur;
+        static int n_in = 0;
+        const std::string sec = node ? ggml_cuda_gprof_section(node) : "end";
+        if (g->n > 0 && sec == cur && node) { n_in++; return; }
+        if (g->n > 0) { g->label[g->n - 1] = cur + " (" + std::to_string(n_in) + " nodes)"; }
+        cur = sec; n_in = 1;
+        if ((int) g->ev.size() <= g->n) {
+            cudaEvent_t e; CUDA_CHECK(cudaEventCreate(&e)); g->ev.push_back(e); g->label.emplace_back();
+        }
+        g->label[g->n] = sec;
+        CUDA_CHECK(cudaEventRecordWithFlags(g->ev[g->n], stream, cudaEventRecordExternal));
+        g->n++;
+        return;
+    }
+    if ((int) g->ev.size() <= g->n) {
+        cudaEvent_t e; CUDA_CHECK(cudaEventCreate(&e)); g->ev.push_back(e); g->label.emplace_back();
+    }
+    g->label[g->n] = ggml_cuda_gprof_label(node);
+    CUDA_CHECK(cudaEventRecordWithFlags(g->ev[g->n], stream, cudaEventRecordExternal));
+    g->n++;
+}
+static void ggml_cuda_gprof_capture_end(cudaStream_t stream) {
+    auto & st = ggml_cuda_gprof();
+    if (!st.capturing) return;
+    ggml_cuda_gprof_mark(stream, nullptr);
+    st.capturing = nullptr;
+}
+static void ggml_cuda_gprof_after_launch(const void * key, cudaStream_t stream) {
+    auto & st = ggml_cuda_gprof();
+    auto it = st.graphs.find(key);
+    if (it == st.graphs.end() || it->second.n < 2) return;
+    auto & g = it->second;
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    for (int i = 0; i + 1 < g.n; ++i) {
+        float ms = 0; CUDA_CHECK(cudaEventElapsedTime(&ms, g.ev[i], g.ev[i + 1]));
+        auto & a = st.acc[g.label[i]]; a.first += ms; a.second += 1; st.total += ms;
+    }
+    st.n_kernels += g.n - 1;
+    if (++st.n_launch % ggml_cuda_gprof_every() == 0) {
+        std::vector<std::pair<double, std::string>> v;
+        for (auto & kv : st.acc) v.push_back({kv.second.first, kv.first});
+        std::sort(v.rbegin(), v.rend());
+        const double n = (double) st.n_launch;
+        fprintf(stderr, "cuda-gprof: %lld launches, GPU %.3f ms per launch, %.1f nodes per launch\n", (long long) st.n_launch, st.total/n, st.n_kernels/n);
+        for (size_t i = 0; i < v.size() && i < 45; ++i) {
+            fprintf(stderr, "cuda-gprof: %7.4f ms %5.1f%% %5.2f/launch %6.1f us each  %s\n", v[i].first/n, 100*v[i].first/st.total,
+                    st.acc[v[i].second].second/n, 1000*v[i].first/st.acc[v[i].second].second, v[i].second.c_str());
+        }
+        st.acc.clear(); st.total = 0; st.n_launch = 0; st.n_kernels = 0;
+    }
+}
