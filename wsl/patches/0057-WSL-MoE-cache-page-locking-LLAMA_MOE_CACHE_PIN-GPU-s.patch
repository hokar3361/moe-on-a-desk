+static void ggml_cuda_mmdbg(const char * path, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    static const bool on = getenv("GGML_CUDA_MMDBG") != nullptr;
+    if (!on) return;
+    static std::set<std::string> seen;
+    std::string nm = dst->name; while (!nm.empty() && isdigit((unsigned char) nm.back())) nm.pop_back();
+    char key[512];
+    snprintf(key, sizeof(key), "%s %s [%lld %lld %lld] nb[%zu %zu %zu] view=%d buf=%s x %s [%lld %lld %lld] nb[%zu %zu %zu] cont=%d -> %s",
+        nm.c_str(), ggml_type_name(src0->type), (long long) src0->ne[0], (long long) src0->ne[1], (long long) src0->ne[2],
+        src0->nb[0], src0->nb[1], src0->nb[2], src0->view_src != nullptr,
+        src0->buffer ? (ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS ? "weights" : "compute") : "-",
+        ggml_type_name(src1->type), (long long) src1->ne[0], (long long) src1->ne[1], (long long) src1->ne[2],
+        src1->nb[0], src1->nb[1], src1->nb[2], ggml_is_contiguous(src1), path);
+    if (seen.insert(key).second && seen.size() < 200) {
+        fprintf(stderr, "cuda-mmdbg: %s\n", key);
+    }
+}
