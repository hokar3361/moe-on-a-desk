From b832e73135ee4e97dde5e4c7abefbbb29d4f1408 Mon Sep 17 00:00:00 2001
From: mac125b <mac125b@example.invalid>
Date: Wed, 14 Oct 2026 21:51:43 +0900
Subject: [PATCH 57/58] WSL: MoE cache page-locking (LLAMA_MOE_CACHE_PIN),
 GPU-side lookup GGML_OP_MOE_FETCH (LLAMA_MOE_CACHE_FETCH) with an adaptive
 free pool per group, next-layer prefetch (negative), profiling
 (LLAMA_MOE_CACHE_LOG, LLAMA_UBATCH_TIME, GGML_SCHED_PROF,
 GGML_CUDA_OPPROF/GPROF, GGML_CUDA_MMDBG)

---
 ggml/include/ggml.h              |  23 ++
 ggml/src/ggml-backend.cpp        |  41 +++
 ggml/src/ggml-cpu/ggml-cpu.c     |   5 +
 ggml/src/ggml-cuda/ggml-cuda.cu  | 252 ++++++++++++++++-
 ggml/src/ggml-cuda/moe-fetch.cu  | 147 ++++++++++
 ggml/src/ggml-cuda/moe-fetch.cuh |   5 +
 ggml/src/ggml.c                  |  36 ++-
 src/llama-context.cpp            |  20 ++
 src/llama-context.h              |   1 +
 src/llama-graph.cpp              |  18 ++
 src/llama-moe-cache.cpp          | 471 ++++++++++++++++++++++++++++++-
 src/llama-moe-cache.h            |  12 +
 src/models/qwen4exp.cpp          |  14 +
 13 files changed, 1040 insertions(+), 5 deletions(-)
 create mode 100644 ggml/src/ggml-cuda/moe-fetch.cu
 create mode 100644 ggml/src/ggml-cuda/moe-fetch.cuh

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 224bdef92..ecedf9566 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -600,6 +600,7 @@ extern "C" {
         GGML_OP_OPT_STEP_SGD,
 
         GGML_OP_GLU,
+        GGML_OP_MOE_FETCH,
 
         GGML_OP_COUNT,
     };
@@ -2719,6 +2720,28 @@ extern "C" {
     //                       + sum_src residual[i, src, t]*comb[dst, src, t]
     //   comb == NULL uses the identity: result[i, dst, t] = x[i, t]*post[dst, t] + residual[i, dst, t]
     //
+    // MoE expert cache, GPU side (fork, CUDA only): the cache slot of each expert id of one layer (I32, same shape as ids).
+    // state (I32, the layer's row of the cache's device state) holds the slot map of the layer, its free slots, a trace for the host
+    // and the list of the misses; desc (I64) holds, per expert tensor of the layer, the device address of the page-locked host experts,
+    // the size of one expert and the device address of the bank. An expert that is not cached is copied by the GPU from host memory into
+    // a free slot of the layer, or into a transient slot when none is left. Row layout: see ggml_moe_fetch_state_size.
+    // pool (I32 [1 + n_pool]): the number of free slots left, then the free slots, shared by the layers of a group
+    GGML_API struct ggml_tensor * ggml_moe_fetch(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * ids,
+            struct ggml_tensor  * state,
+            struct ggml_tensor  * desc,
+            struct ggml_tensor  * pool,
+            int                   n_expert,
+            int                   n_trace,
+            int                   transient_base,
+            int                   n_transient);
+
+    // number of I32 in a state row: slot map [n_expert], n_trace, trace [2*n_trace], n_miss, miss [2*n_trace]
+    static inline int ggml_moe_fetch_state_size(int n_expert, int n_trace) {
+        return n_expert + 1 + 2*n_trace + 1 + 2*n_trace;
+    }
+
     GGML_API struct ggml_tensor * ggml_dsv4_hc_post(
             struct ggml_context * ctx,
             struct ggml_tensor  * x,
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 51541dd21..686a42699 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1856,10 +1856,18 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
 
     int prev_backend_id = -1;
 
+    static const int prof_every = getenv("GGML_SCHED_PROF") ? atoi(getenv("GGML_SCHED_PROF")) : 0;
+    static double prof_t[8][GGML_SCHED_MAX_BACKENDS] = {}; // 0 inputs, 1 host weights, 2 launch, 3 sync, 4 splits, 5 wall
+    static int prof_n = 0;
+    const bool prof = prof_every > 0 && sched->n_splits > 8;
+    const int64_t prof_t_start = prof ? ggml_time_us() : 0;
+    int64_t prof_ta = 0;
+
     for (int split_id = 0; split_id < sched->n_splits; split_id++) {
         struct ggml_backend_sched_split * split = &splits[split_id];
         int split_backend_id = split->backend_id;
         ggml_backend_t split_backend = sched->backends[split_backend_id];
+        if (prof) { prof_ta = ggml_time_us(); prof_t[4][split_backend_id] += 1; }
 
         // ensure the previous split's async work has completed before we start
         // this split, the allocator may have reused buffer regions across splits
@@ -1871,6 +1879,7 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             }
         }
 
+        if (prof) { const int64_t t = ggml_time_us(); prof_t[3][split_backend_id] += (t - prof_ta)/1000.0; prof_ta = t; }
         // copy the input tensors to the split backend
         // the weights in host memory are copied last, so that the copy callback can read the other inputs of the split
         for (int input_id = 0; input_id < split->n_inputs; input_id++) {
@@ -1878,11 +1887,13 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
                 ggml_backend_sched_copy_input(sched, split, split->inputs[input_id]);
             }
         }
+        if (prof) { const int64_t t = ggml_time_us(); prof_t[0][split_backend_id] += (t - prof_ta)/1000.0; prof_ta = t; }
         for (int input_id = 0; input_id < split->n_inputs; input_id++) {
             if (ggml_backend_sched_is_host_weight(split->inputs[input_id])) {
                 ggml_backend_sched_copy_input(sched, split, split->inputs[input_id]);
             }
         }
+        if (prof) { const int64_t t = ggml_time_us(); prof_t[1][split_backend_id] += (t - prof_ta)/1000.0; prof_ta = t; }
 
         if (!sched->callback_eval) {
             // GGML_SCHED_TIME=1: host time of every non-Metal split (profiling)
@@ -1933,6 +1944,20 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             }
         }
 
+        if (prof) {
+            static const bool prof_sync = getenv("GGML_SCHED_PROF_SYNC") != nullptr;
+            if (prof_sync) {
+                ggml_backend_synchronize(split_backend);
+            }
+            bool has_hw = false;
+            for (int input_id = 0; input_id < split->n_inputs; input_id++) {
+                has_hw = has_hw || ggml_backend_sched_is_host_weight(split->inputs[input_id]);
+            }
+            const int64_t t = ggml_time_us();
+            prof_t[has_hw ? 6 : 2][split_backend_id] += (t - prof_ta)/1000.0; prof_ta = t;
+            if (has_hw) prof_t[7][split_backend_id] += 1;
+        }
+
         // record the event of this split
         if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
             ggml_backend_event_record(sched->events[split_backend_id][sched->cur_copy], split_backend);
@@ -1941,6 +1966,22 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         prev_backend_id = split_backend_id;
     }
 
+    if (prof) {
+        prof_t[5][0] += (ggml_time_us() - prof_t_start)/1000.0;
+        if (++prof_n % prof_every == 0) {
+            fprintf(stderr, "sched-prof: %d graphs, per graph: wall %.3f ms\n", prof_every, prof_t[5][0]/prof_every);
+            for (int b = 0; b < sched->n_backends; ++b) {
+                if (prof_t[4][b] == 0) continue;
+                fprintf(stderr, "sched-prof:   %-8s splits %5.1f  sync-before %.3f  inputs %.3f  host-weights %.3f  launch %.3f ms\n",
+                        ggml_backend_name(sched->backends[b]), prof_t[4][b]/prof_every, prof_t[3][b]/prof_every, prof_t[0][b]/prof_every,
+                        prof_t[1][b]/prof_every, prof_t[2][b]/prof_every);
+                fprintf(stderr, "sched-prof:   %-8s   of which MoE-cache splits %5.1f: launch %.3f ms\n", ggml_backend_name(sched->backends[b]),
+                        prof_t[7][b]/prof_every, prof_t[6][b]/prof_every);
+            }
+            memset(prof_t, 0, sizeof(prof_t));
+        }
+    }
+
     return GGML_STATUS_SUCCESS;
 }
 
