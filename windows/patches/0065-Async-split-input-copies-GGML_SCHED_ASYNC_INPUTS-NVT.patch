diff --git a/include/llama-nvtx.h b/include/llama-nvtx.h
new file mode 100644
index 000000000..e8f8f6d73
--- /dev/null
+++ b/include/llama-nvtx.h
@@ -0,0 +1,25 @@
+#pragma once
+// fork: NVTX ranges for Nsight Systems (LLAMA_NVTX is defined by the build when the CUDA toolkit is found)
+#if defined(LLAMA_NVTX) && defined(__has_include)
+#if __has_include(<nvtx3/nvToolsExt.h>)
+#if defined(_WIN32) && !defined(NOMINMAX)
+#define NOMINMAX
+#endif
+#include <nvtx3/nvToolsExt.h>
+#ifdef small
+#undef small
+#endif
+#include <cstdio>
+struct llama_nvtx_range {
+    explicit llama_nvtx_range(const char * name) { nvtxRangePushA(name); }
+    llama_nvtx_range(const char * name, int n) { char b[64]; snprintf(b, sizeof(b), "%s %d", name, n); nvtxRangePushA(b); }
+    ~llama_nvtx_range() { nvtxRangePop(); }
+};
+#define LLAMA_NVTX_CAT2(a, b) a##b
+#define LLAMA_NVTX_CAT(a, b) LLAMA_NVTX_CAT2(a, b)
+#define LLAMA_NVTX_RANGE(...) llama_nvtx_range LLAMA_NVTX_CAT(llama_nvtx_r_, __LINE__)(__VA_ARGS__)
+#endif
+#endif
+#ifndef LLAMA_NVTX_RANGE
+#define LLAMA_NVTX_RANGE(...) do {} while (0)
+#endif
