+    // LLAMA_SPEC_PMIN_AUTO=1: the threshold of the confidence stop chosen online from the measured tokens per ms
+    struct pmin_auto {
+        bool enabled = false;
+        static constexpr int NA = 5;
+        float arm[NA]  = { 0.35f, 0.5f, 0.65f, 0.8f, 0.9f };
+        float rate[NA] = { 0, 0, 0, 0, 0 };   // tokens per ms, EMA (0 = not tried)
+        int   cur = 2;
+        int   explore_every = 8;
+        float a = 0.25f;
+        int64_t t_prev_us = 0;
+        int   warm = 0;      // rounds of the initial round-robin of this request
+        int   n_warm = 3;    // each arm this many times first
+        int   last_acc = -1;
+        uint64_t rounds = 0;
+        uint64_t played[NA] = {};
+        void init() {
+            enabled = getenv("LLAMA_SPEC_PMIN_AUTO") && atoi(getenv("LLAMA_SPEC_PMIN_AUTO")) != 0;
+            if (const char * e = getenv("LLAMA_SPEC_PMIN_EXPLORE")) explore_every = std::max(2, atoi(e));
+        }
+        float threshold() const { return arm[cur]; }
+        // a round begins: score the last one, pick the arm of this one
+        void begin_round() {
+            const int64_t now = ggml_time_us();
+            if (t_prev_us > 0 && last_acc >= 0) {
+                const float ms = (now - t_prev_us)/1000.0f;
+                if (ms > 2.0f && ms < 150.0f) {
+                    const float r = (last_acc + 1)/ms;
+                    rate[cur] = rate[cur] > 0 ? (1.0f - a)*rate[cur] + a*r : r;
+                }
+            }
+            t_prev_us = now;
+            last_acc  = -1;
+            int best = cur;
+            for (int k = 0; k < NA; ++k) {
+                if (rate[k] > rate[best]) best = k;
+            }
+            rounds++;
+            if (warm < NA*n_warm) {
+                // the initial round-robin of a request: every threshold measured on this text
+                cur = warm % NA;
+                warm++;
+            } else if (rounds % explore_every == 0) {
+                // a neighbour of the best arm, alternating sides; untried arms first
+                int nb = -1;
+                for (int k = 0; k < NA; ++k) if (rate[k] == 0) { nb = k; break; }
+                if (nb < 0) nb = ((rounds / explore_every) % 2) ? std::min(best + 1, NA - 1) : std::max(best - 1, 0);
+                cur = nb;
+            } else {
+                cur = best;
+            }
+            played[cur]++;
+            if (rounds % 400 == 0) {
+                LOG_WRN("pmin auto: rounds %llu, arm rates %.3f %.3f %.3f %.3f %.3f tok/ms, best %.2f\n", (unsigned long long) rounds,
+                        rate[0], rate[1], rate[2], rate[3], rate[4], arm[best]);
+            }
+        }
+        // a new request: what pays depends on the text, so the arms are measured again
+        void reset_request() {
+            t_prev_us = 0; last_acc = -1; warm = 0;
+            for (int k = 0; k < NA; ++k) rate[k] = 0.0f;
+        }
+    };
