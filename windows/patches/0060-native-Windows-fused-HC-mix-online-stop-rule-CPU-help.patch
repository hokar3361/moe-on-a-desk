+// ggml_compute_forward_hc_mix (fork, reference)
+
+static float hc_mix_w(const ggml_tensor * w, int64_t row, int64_t k) {
+    const char * p = (const char *) w->data + row*w->nb[1];
+    switch (w->type) {
+        case GGML_TYPE_F32:  return ((const float *) p)[k];
+        case GGML_TYPE_F16:  return GGML_CPU_FP16_TO_FP32(((const ggml_fp16_t *) p)[k]);
+        case GGML_TYPE_BF16: return GGML_BF16_TO_FP32(((const ggml_bf16_t *) p)[k]);
+        default: GGML_ABORT("hc_mix: weight type");
+    }
+}
+
+void ggml_compute_forward_hc_mix(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (params->ith != 0) {
+        return;
+    }
+    const ggml_tensor * x  = dst->src[0];
+    const ggml_tensor * wn = dst->src[1];
+    const ggml_tensor * wd = dst->src[2];
+    const ggml_tensor * wu = dst->src[3];
+    const ggml_tensor * wi = dst->src[4];
+    const float eps = ggml_get_op_params_f32(dst, 0), scale = ggml_get_op_params_f32(dst, 1), out_scale = ggml_get_op_params_f32(dst, 2);
+    const int64_t ne = x->ne[0], hc = x->ne[1], nt = x->ne[2], K = ne*hc, nlo = wd->ne[1];
+    float * mixed = (float *) dst->data;
+    float * inj   = mixed + ne*nt;
+    std::vector<float> xn(K), a(nlo);
+    for (int64_t t = 0; t < nt; ++t) {
+        const float * xt = (const float *) ((const char *) x->data + t*x->nb[2]);
+        for (int64_t c = 0; c < hc; ++c) {
+            double s = 0.0;
+            for (int64_t k = 0; k < ne; ++k) {
+                s += (double) xt[c*ne + k]*xt[c*ne + k];
+            }
+            const float r = 1.0f/sqrtf((float) (s/ne) + eps);
+            for (int64_t k = 0; k < ne; ++k) {
+                xn[c*ne + k] = xt[c*ne + k]*r*((const float *) wn->data)[c*ne + k];
+            }
+        }
+        for (int64_t n = 0; n < nlo; ++n) {
+            float s = 0.0f;
+            for (int64_t k = 0; k < K; ++k) {
+                s += hc_mix_w(wd, n, k)*xn[k];
+            }
+            const float v = s*scale;
+            a[n] = v/(1.0f + expf(-v));
+        }
+        for (int64_t c = 0; c < hc; ++c) {
+            float s = 0.0f;
+            if (wi) {
+                for (int64_t k = 0; k < K; ++k) {
+                    s += hc_mix_w(wi, c, k)*xn[k];
+                }
+            }
+            inj[t*hc + c] = s;
+        }
+        for (int64_t i = 0; i < ne; ++i) {
+            float m = 0.0f;
+            for (int64_t c = 0; c < hc; ++c) {
+                float g = 0.0f;
+                for (int64_t n = 0; n < nlo; ++n) {
+                    g += hc_mix_w(wu, c*ne + i, n)*a[n];
+                }
+                m += xn[c*ne + i]/(1.0f + expf(-g));
+            }
+            mixed[t*ne + i] = m*out_scale;
+        }
+    }
+}
