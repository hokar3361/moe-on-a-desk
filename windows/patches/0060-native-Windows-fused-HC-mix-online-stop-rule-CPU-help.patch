+// waits for the CPU worker, then adds its rows (or, GGML_MOE_CPU_VERIFY, compares them with the GPU's)
+static __global__ void k_moe_cpu_recv(float * __restrict__ experts, ggml_moe_cpu_box * box, const int verify) {
+    __shared__ int   s_go;
+    __shared__ float s_dmax[32], s_gmax[32];
+    volatile ggml_moe_cpu_box * b = box;
+    if (threadIdx.x == 0) {
+        s_go = 0;
+        const int nj = b->n_jobs;
+        if (nj > 0) {
+            const uint32_t want = b->req;
+            const long long t0 = clock64();
+            const uint64_t g0 = moe_globaltimer();
+            for (;;) {
+                if (b->ack == want) {
+                    s_go = 1;
+                    const uint64_t g1 = moe_globaltimer();
+                    b->sum_window = b->sum_window + (g0 - b->t_send);
+                    b->sum_wait   = b->sum_wait + (g1 - g0);
+                    b->n_wait     = b->n_wait + 1;
+                    break;
+                }
+                // about 1-2 s at the GPU clock: never hang the GPU (Windows resets the driver after 2 s)
+                if (clock64() - t0 > 2000000000LL) {
+                    b->flags = b->flags | GGML_MOE_CPU_TIMEOUT;
+                    break;
+                }
+                __nanosleep(200);
+            }
+        }
+        __threadfence_system();
+    }
+    __syncthreads();
+    if (!s_go) {
+        return;
+    }
+    const int nj     = b->n_jobs;
+    const int n_embd = b->n_embd;
+    const float * d  = (const float *) ((const char *) box + GGML_MOE_CPU_HDR) + (size_t) GGML_MOE_CPU_MAX_TOK*n_embd;
+    float dmax = 0.0f, gmax = 0.0f;
+    for (int j = 0; j < nj; ++j) {
+        const int i = b->job_i[j];
+        float       * row = experts + (size_t) i*n_embd;
+        const float * src = d + (size_t) j*n_embd;
+        for (int c = threadIdx.x; c < n_embd; c += blockDim.x) {
+            if (verify) {
+                dmax = fmaxf(dmax, fabsf(row[c] - src[c]));
+                gmax = fmaxf(gmax, fabsf(row[c]));
+            } else {
+                row[c] += src[c];
+            }
+        }
+    }
+    if (!verify) {
+        return;
+    }
+    for (int o = 16; o > 0; o >>= 1) {
+        dmax = fmaxf(dmax, __shfl_xor_sync(0xffffffff, dmax, o));
+        gmax = fmaxf(gmax, __shfl_xor_sync(0xffffffff, gmax, o));
+    }
+    if (threadIdx.x % 32 == 0) {
+        s_dmax[threadIdx.x / 32] = dmax;
+        s_gmax[threadIdx.x / 32] = gmax;
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        for (int w = 1; w < (int) blockDim.x / 32; ++w) {
+            dmax = fmaxf(dmax, s_dmax[w]);
+            gmax = fmaxf(gmax, s_gmax[w]);
+        }
+        const float e = gmax > 0.0f ? dmax / gmax : 0.0f;
+        b->err = e;
+        if (e > b->err_max) {
+            b->err_max = e;
+        }
+        __threadfence_system();
+    }
+}
