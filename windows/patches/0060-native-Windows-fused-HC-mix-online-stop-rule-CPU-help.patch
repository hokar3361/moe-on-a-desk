index 000000000..55a91366c
--- /dev/null
+++ b/ggml/src/ggml-cuda/hc-mix.cu
@@ -0,0 +1,232 @@
+#include "hc-mix.cuh"
+
+// Fused hyper-connection mix (fork, GGML_OP_HC_MIX), few tokens: see ggml_hc_mix in ggml.h.
+// k_hc_rms: r[c,t] = 1/sqrt(mean x^2 + eps) per stream and token.
+// k_hc_down: rows of W_down (then of W_inject) times xn = x * w_norm * r, xn built on the fly; a block holds RPB rows and splits K
+//            over its warps; every lane reads 8 consecutive bf16 (16 bytes) per row and step.
+// k_hc_up: one warp per output i: the hc rows c*n_embd + i of W_up times a = silu(lo * scale), then the gated mean over the streams.
+
+#define HC_N 4
+#define HC_RPB 2
+#define HC_NW 8
+
+static __global__ void k_hc_rms(const float * __restrict__ x, float * __restrict__ r, const int ne, const float eps) {
+    const int c = blockIdx.x % HC_N, t = blockIdx.x / HC_N;
+    const float * xs = x + (size_t) t*ne*HC_N + (size_t) c*ne;
+    float s = 0.f;
+    for (int k = threadIdx.x; k < ne; k += blockDim.x) {
+        const float v = xs[k];
+        s += v*v;
+    }
+    __shared__ float sh[32];
+    s = warp_reduce_sum(s);
+    if (threadIdx.x % WARP_SIZE == 0) {
+        sh[threadIdx.x / WARP_SIZE] = s;
+    }
+    __syncthreads();
+    if (threadIdx.x < WARP_SIZE) {
+        s = threadIdx.x < blockDim.x / WARP_SIZE ? sh[threadIdx.x] : 0.f;
+        s = warp_reduce_sum(s);
+        if (threadIdx.x == 0) {
+            r[t*HC_N + c] = rsqrtf(s / ne + eps);
+        }
+    }
+}
+
+template <int B>
+static __global__ void k_hc_down(const float * __restrict__ x, const float * __restrict__ wn, const float * __restrict__ r,
+        const nv_bfloat16 * __restrict__ wd, const nv_bfloat16 * __restrict__ wi, float * __restrict__ out,
+        const int ne, const int nlo, const int nrows) {
+    const int K    = ne*HC_N;
+    const int row0 = blockIdx.x*HC_RPB;
+    const int warp = threadIdx.x / WARP_SIZE, lane = threadIdx.x % WARP_SIZE;
+    float acc[HC_RPB][B];
+#pragma unroll
+    for (int i = 0; i < HC_RPB; ++i) {
+#pragma unroll
+        for (int t = 0; t < B; ++t) {
+            acc[i][t] = 0.f;
+        }
+    }
+    const int kslice = K / HC_NW;
+    const int k0     = warp*kslice;
+    for (int k = k0 + lane*8; k < k0 + kslice; k += WARP_SIZE*8) {
+        const int c = k / ne;
+        float xv[B][8];
+        const float4 w0 = *(const float4 *) (wn + k);
+        const float4 w1 = *(const float4 *) (wn + k + 4);
+        const float g[8] = { w0.x, w0.y, w0.z, w0.w, w1.x, w1.y, w1.z, w1.w };
+#pragma unroll
+        for (int t = 0; t < B; ++t) {
+            const float4 a0 = *(const float4 *) (x + (size_t) t*K + k);
+            const float4 a1 = *(const float4 *) (x + (size_t) t*K + k + 4);
+            const float  s  = r[t*HC_N + c];
+            xv[t][0] = a0.x*g[0]*s; xv[t][1] = a0.y*g[1]*s; xv[t][2] = a0.z*g[2]*s; xv[t][3] = a0.w*g[3]*s;
+            xv[t][4] = a1.x*g[4]*s; xv[t][5] = a1.y*g[5]*s; xv[t][6] = a1.z*g[6]*s; xv[t][7] = a1.w*g[7]*s;
+        }
+#pragma unroll
+        for (int i = 0; i < HC_RPB; ++i) {
+            const int row = row0 + i;
+            if (row >= nrows) {
+                break;
+            }
+            const nv_bfloat16 * wr = row < nlo ? wd + (size_t) row*K : wi + (size_t) (row - nlo)*K;
+            const uint4 u = *(const uint4 *) (wr + k);
+            const nv_bfloat162 * h = (const nv_bfloat162 *) &u;
+            float wv[8];
+#pragma unroll
+            for (int q = 0; q < 4; ++q) {
+                const float2 f = __bfloat1622float2(h[q]);
+                wv[2*q] = f.x;
+                wv[2*q + 1] = f.y;
+            }
+#pragma unroll
+            for (int t = 0; t < B; ++t) {
+                float s = acc[i][t];
+#pragma unroll
+                for (int q = 0; q < 8; ++q) {
+                    s = fmaf(wv[q], xv[t][q], s);
+                }
+                acc[i][t] = s;
+            }
+        }
+    }
+    __shared__ float red[HC_NW][HC_RPB][B];
+#pragma unroll
+    for (int i = 0; i < HC_RPB; ++i) {
+#pragma unroll
+        for (int t = 0; t < B; ++t) {
+            const float s = warp_reduce_sum(acc[i][t]);
+            if (lane == 0) {
+                red[warp][i][t] = s;
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.x < HC_RPB*B) {
+        const int i = threadIdx.x / B, t = threadIdx.x % B;
+        float s = 0.f;
+        for (int w = 0; w < HC_NW; ++w) {
+            s += red[w][i][t];
+        }
+        if (row0 + i < nrows) {
+            out[(size_t) t*nrows + row0 + i] = s;
+        }
+    }
+}
+
+template <int B>
+static __global__ void k_hc_up(const float * __restrict__ x, const float * __restrict__ wn, const float * __restrict__ r,
+        const float * __restrict__ lo, const nv_bfloat16 * __restrict__ wu, float * __restrict__ mixed, float * __restrict__ inj,
+        const int ne, const int nlo, const int nrows, const float scale, const float out_scale, const int has_inject) {
+    extern __shared__ float a[]; // [B][nlo]
+    for (int j = threadIdx.x; j < B*nlo; j += blockDim.x) {
+        const int t = j / nlo, n = j % nlo;
+        const float v = lo[(size_t) t*nrows + n]*scale;
+        a[j] = v / (1.f + expf(-v));
+    }
+    // the injection rows are copied by the first block
+    if (blockIdx.x == 0 && threadIdx.x < B*HC_N) {
+        const int t = threadIdx.x / HC_N, c = threadIdx.x % HC_N;
+        inj[t*HC_N + c] = has_inject ? lo[(size_t) t*nrows + nlo + c] : 0.f;
+    }
+    __syncthreads();
+    const int K    = ne*HC_N;
+    const int warp = threadIdx.x / WARP_SIZE, lane = threadIdx.x % WARP_SIZE;
+    const int i    = blockIdx.x*(blockDim.x / WARP_SIZE) + warp;
+    if (i >= ne) {
+        return;
+    }
+    float g[HC_N][B];
+#pragma unroll
+    for (int c = 0; c < HC_N; ++c) {
+        const nv_bfloat16 * wr = wu + (size_t) (c*ne + i)*nlo;
+        float s[B];
+#pragma unroll
+        for (int t = 0; t < B; ++t) {
+            s[t] = 0.f;
+        }
+        for (int n = lane*2; n < nlo; n += WARP_SIZE*2) {
+            const float2 w = __bfloat1622float2(*(const nv_bfloat162 *) (wr + n));
+#pragma unroll
+            for (int t = 0; t < B; ++t) {
+                s[t] = fmaf(w.x, a[t*nlo + n], fmaf(w.y, a[t*nlo + n + 1], s[t]));
+            }
+        }
+#pragma unroll
+        for (int t = 0; t < B; ++t) {
+            g[c][t] = warp_reduce_sum(s[t]);
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < B; ++t) {
+        if (lane == t) {
+            float m = 0.f;
+#pragma unroll
+            for (int c = 0; c < HC_N; ++c) {
+                const int k = c*ne + i;
+                const float xn = x[(size_t) t*K + k]*wn[k]*r[t*HC_N + c];
+                m += xn / (1.f + expf(-g[c][t]));
+            }
+            mixed[(size_t) t*ne + i] = m*out_scale;
+        }
+    }
+}
+
+template <int B>
+static void hc_mix_launch(ggml_backend_cuda_context & ctx, const float * x, const float * wn, const nv_bfloat16 * wd, const nv_bfloat16 * wu,
+        const nv_bfloat16 * wi, float * mixed, float * inj, const int ne, const int nlo, const float eps, const float scale, const float out_scale) {
+    cudaStream_t stream = ctx.stream();
+    const int nrows = nlo + (wi ? HC_N : 0);
+    ggml_cuda_pool_alloc<float> r(ctx.pool(), B*HC_N);
+    ggml_cuda_pool_alloc<float> lo(ctx.pool(), (size_t) B*(nlo + HC_N));
+    k_hc_rms<<<B*HC_N, 256, 0, stream>>>(x, r.get(), ne, eps);
+    k_hc_down<B><<<(nrows + HC_RPB - 1)/HC_RPB, HC_NW*WARP_SIZE, 0, stream>>>(x, wn, r.get(), wd, wi, lo.get(), ne, nlo, nrows);
+    const int wpb = 8;
+    k_hc_up<B><<<(ne + wpb - 1)/wpb, wpb*WARP_SIZE, (size_t) B*nlo*sizeof(float), stream>>>(x, wn, r.get(), lo.get(), wu, mixed, inj,
+            ne, nlo, nrows, scale, out_scale, wi != nullptr);
+}
+
+bool ggml_cuda_hc_mix_supported(const ggml_tensor * op) {
+    const ggml_tensor * x  = op->src[0];
+    const ggml_tensor * wn = op->src[1];
+    const ggml_tensor * wd = op->src[2];
+    const ggml_tensor * wu = op->src[3];
+    const ggml_tensor * wi = op->src[4];
+    const int64_t ne = x->ne[0], hc = x->ne[1], nt = x->ne[2], K = ne*hc, nlo = wd->ne[1];
+    return x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) && hc == HC_N && nt >= 1 && nt <= 8 &&
+        wn->type == GGML_TYPE_F32 && wd->type == GGML_TYPE_BF16 && wu->type == GGML_TYPE_BF16 &&
+        ggml_is_contiguous(wd) && ggml_is_contiguous(wu) && ggml_is_contiguous(wn) &&
+        (wi == nullptr || (wi->type == GGML_TYPE_BF16 && ggml_is_contiguous(wi))) &&
+        K % (HC_NW*WARP_SIZE*8) == 0 && nlo % 64 == 0 && nlo <= 1024;
+}
+
+void ggml_cuda_op_hc_mix(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x  = dst->src[0];
+    const ggml_tensor * wn = dst->src[1];
+    const ggml_tensor * wd = dst->src[2];
+    const ggml_tensor * wu = dst->src[3];
+    const ggml_tensor * wi = dst->src[4];
+    const float * p = (const float *) dst->op_params;
+    const float eps = p[0], scale = p[1], out_scale = p[2];
+    const int ne = (int) x->ne[0], nt = (int) x->ne[2], nlo = (int) wd->ne[1];
+    float * mixed = (float *) dst->data;
+    float * inj   = mixed + (size_t) ne*nt;
+    const float * xp = (const float *) x->data;
+    const float * wnp = (const float *) wn->data;
+    const nv_bfloat16 * wdp = (const nv_bfloat16 *) wd->data;
+    const nv_bfloat16 * wup = (const nv_bfloat16 *) wu->data;
+    const nv_bfloat16 * wip = wi ? (const nv_bfloat16 *) wi->data : nullptr;
+    switch (nt) {
+        case 1: hc_mix_launch<1>(ctx, xp, wnp, wdp, wup, wip, mixed, inj, ne, nlo, eps, scale, out_scale); break;
+        case 2: hc_mix_launch<2>(ctx, xp, wnp, wdp, wup, wip, mixed, inj, ne, nlo, eps, scale, out_scale); break;
+        case 3: hc_mix_launch<3>(ctx, xp, wnp, wdp, wup, wip, mixed, inj, ne, nlo, eps, scale, out_scale); break;
+        case 4: hc_mix_launch<4>(ctx, xp, wnp, wdp, wup, wip, mixed, inj, ne, nlo, eps, scale, out_scale); break;
+        case 5: hc_mix_launch<5>(ctx, xp, wnp, wdp, wup, wip, mixed, inj, ne, nlo, eps, scale, out_scale); break;
+        case 6: hc_mix_launch<6>(ctx, xp, wnp, wdp, wup, wip, mixed, inj, ne, nlo, eps, scale, out_scale); break;
+        case 7: hc_mix_launch<7>(ctx, xp, wnp, wdp, wup, wip, mixed, inj, ne, nlo, eps, scale, out_scale); break;
+        case 8: hc_mix_launch<8>(ctx, xp, wnp, wdp, wup, wip, mixed, inj, ne, nlo, eps, scale, out_scale); break;
+        default: GGML_ABORT("hc_mix: unsupported token count");
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
