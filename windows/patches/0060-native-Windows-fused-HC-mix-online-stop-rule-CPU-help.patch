+
+struct ggml_tensor * ggml_hc_mix(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * w_norm,
+        struct ggml_tensor  * w_down,
+        struct ggml_tensor  * w_up,
+        struct ggml_tensor  * w_inject,
+        float                 eps,
+        float                 scale,
+        float                 out_scale) {
+    const int64_t ne = x->ne[0], hc = x->ne[1], nt = x->ne[2];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ggml_is_contiguous(x));
+    GGML_ASSERT(ggml_nelements(w_norm) == ne*hc);
+    GGML_ASSERT(w_down->ne[0] == ne*hc && w_up->ne[1] == ne*hc && w_up->ne[0] == w_down->ne[1]);
+    GGML_ASSERT(w_inject == NULL || (w_inject->ne[0] == ne*hc && w_inject->ne[1] == hc));
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne*nt + hc*nt);
+
+    const float params[] = { eps, scale, out_scale };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_HC_MIX;
+    result->src[0] = x;
+    result->src[1] = w_norm;
+    result->src[2] = w_down;
+    result->src[3] = w_up;
+    result->src[4] = w_inject;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_moe_cpu_recv(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * experts,
+        struct ggml_tensor  * slots,
+        void                * box,
+        int                   flags) {
+    GGML_ASSERT(experts->type == GGML_TYPE_F32 && ggml_is_contiguous(experts));
+    GGML_ASSERT(slots->type == GGML_TYPE_I32);
+
+    // in place: only the rows the CPU computed change
+    struct ggml_tensor * result = ggml_view_tensor(ctx, experts);
+
+    const uint64_t b = (uint64_t) (uintptr_t) box;
+    const int32_t params[] = { (int32_t) (b & 0xffffffffu), (int32_t) (b >> 32), flags };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_MOE_CPU_RECV;
+    result->src[0] = experts;
+    result->src[1] = slots;
+
+    return result;
+}
