+        // online verify times (LLAMA_SPEC_STOP_ONLINE, default on): the measured round time minus the draft steps updates tv at the
+        // width of that round (EMA), kept non-decreasing in the width, so the rule follows the machine and the cache state
+        bool  online = true;
+        float tv_a   = 0.1f;
+        bool  tv_seen[18] = {};
+        // exploration: every explore_every rounds one stop decision is overruled, so the width above the usual one keeps being measured
+        int   explore_every = 16;
+        int   explore_left  = 0;
+        bool  explore_now() {
+            if (explore_left > 0) {
+                explore_left--;
+                return true;
+            }
+            return false;
+        }
+        void observe_round(int n_drafts, float ms) {
+            const int w = std::min(n_drafts + 1, 17);
+            float est = ms - c_draft*n_drafts;
+            if (w < 1 || est <= 1.0f) {
+                return;
+            }
+            // one round may include other work (a prompt, a cold expert burst): it moves the table by at most -40 % / +50 %
+            if (tv[w] > 0.0f) {
+                est = std::min(std::max(est, 0.6f*tv[w]), 1.5f*tv[w]);
+            }
+            tv[w] = tv_seen[w] ? (1.0f - tv_a)*tv[w] + tv_a*est : 0.5f*(tv[w] + est);
+            tv_seen[w] = true;
+            for (int j = w + 1; j < 18; ++j) {
+                tv[j] = std::max(tv[j], tv[j - 1] + 0.3f);
+            }
+            for (int j = w - 1; j >= 1; --j) {
+                tv[j] = std::min(tv[j], tv[j + 1] - 0.3f);
+            }
+        }
