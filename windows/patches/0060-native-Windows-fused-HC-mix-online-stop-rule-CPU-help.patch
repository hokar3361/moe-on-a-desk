+
+bool llama_model::share_output_from(const llama_model & src_ref) {
+    llama_model * dst = this;
+    const llama_model * src = &src_ref;
+    if (dst == src || !dst->output || !src->output || dst->output_s || src->output_s) {
+        return false;
+    }
+    if (dst->output->ne[0] != src->output->ne[0] || dst->output->ne[1] != src->output->ne[1] ||
+            !src->output->buffer || ggml_backend_buffer_is_host(src->output->buffer)) {
+        return false;
+    }
+    ggml_tensor * coarse = nullptr;
+    if (dst->output_coarse) {
+        const ggml_type type = dst->output_coarse->type;
+        const int64_t t0 = ggml_time_us();
+        coarse = llama_requantize_copy(src->output, type, "output_coarse", dst->pimpl->ctxs_bufs, ggml_backend_buffer_get_type(src->output->buffer));
+        if (!coarse) {
+            return false;
+        }
+        LLAMA_LOG_INFO("%s: draft coarse head %s rebuilt from the target head %s in %.1f s\n", __func__,
+                ggml_type_name(type), ggml_type_name(src->output->type), (ggml_time_us() - t0)/1e6);
+    }
+    dst->output = src->output;
+    if (coarse) {
+        dst->output_coarse = coarse;
+    }
+    return true;
+}
+
 int32_t llama_model_n_embd(const llama_model * model) {
     return model->hparams.n_embd;
 }
