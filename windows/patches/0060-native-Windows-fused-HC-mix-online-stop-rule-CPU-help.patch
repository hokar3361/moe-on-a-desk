+    // MoE expert cache with CPU help (fork, CUDA only). The fetch of a layer may leave some of its misses to a CPU worker instead of
+    // copying them over PCIe: those experts get zero_slot (an all-zero slot of the bank, so the GPU computes zeros for them), and the
+    // GPU writes the MoE input x and the list of (id index, expert) jobs into the box, a page-locked host buffer the GPU reads and writes
+    // directly, then rings the bell (req = req + 1). The CPU worker computes the experts of the jobs and acknowledges (ack = req).
+    // ggml_moe_cpu_recv (in place on the expert outputs [n_embd, n_expert_used, n_tokens], before the router weights) waits for the
+    // acknowledgement and adds the CPU results to the rows of the jobs. No CUDA synchronisation: it works inside CUDA graphs.
+    // Misses are ranked by the number of their tokens (then by first use); the first max_pcie of a layer are copied over PCIe.
+    // flags: GGML_MOE_CPU_VERIFY = every miss is copied as usual and the jobs are computed by the CPU too; the receive compares
+    // instead of adding (max relative error in the box), for checking the CPU path.
+#define GGML_MOE_CPU_MAX_JOBS  96
+#define GGML_MOE_CPU_MAX_TOK   8
+#define GGML_MOE_CPU_HDR       4096
+#define GGML_MOE_CPU_VERIFY    1
+#define GGML_MOE_CPU_TIMEOUT   2   // set by the GPU in the box when it stopped waiting for the CPU (the CPU rows are then left out)
+    struct ggml_moe_cpu_box {
+        uint32_t req;        uint32_t pad0[15];
+        uint32_t ack;        uint32_t pad1[15];
+        int32_t  il, n_tok, n_used, n_jobs, n_embd, flags;
+        float    err;        // GGML_MOE_CPU_VERIFY: max |gpu - cpu| / max |gpu| over the rows of the last checked layer
+        float    err_max;    // the largest err since the host last cleared it
+        uint64_t t_send;     // GPU global timer (ns) when the bell rang
+        uint64_t sum_window; // ns from the bell to the start of the receive, summed (statistics)
+        uint64_t sum_wait;   // ns the receive waited for the CPU, summed (statistics)
+        uint32_t n_wait;
+        uint32_t pad2;
+        int32_t  job_i[GGML_MOE_CPU_MAX_JOBS];   // index into the ids (k + n_used*token)
+        int32_t  job_e[GGML_MOE_CPU_MAX_JOBS];   // expert
+        // then at GGML_MOE_CPU_HDR: x [GGML_MOE_CPU_MAX_TOK][n_embd] f32, then d [GGML_MOE_CPU_MAX_JOBS][n_embd] f32
+    };
+    static inline size_t ggml_moe_cpu_box_size(int n_embd) {
+        return GGML_MOE_CPU_HDR + (size_t) (GGML_MOE_CPU_MAX_TOK + GGML_MOE_CPU_MAX_JOBS)*n_embd*sizeof(float);
+    }
+
+    // box: device address of the box; x: f32 [n_embd, n_tokens], contiguous
+    GGML_API void ggml_moe_fetch_set_cpu(
+            struct ggml_tensor  * fetch,
+            struct ggml_tensor  * x,
+            void                * box,
+            int                   zero_slot,
+            int                   max_pcie,
+            int                   flags);
+
+    // fused hyper-connection mix (fork): x f32 [n_embd, hc, n_tokens] (contiguous), w_norm f32 [n_embd*hc], w_down [n_embd*hc, n_lo],
+    // w_up [n_lo, n_embd*hc], w_inject [n_embd*hc, hc] or NULL:
+    //   xn = rms_norm(x per stream, eps) * w_norm;  lo = w_down xn;  gate = w_up silu(lo*scale)
+    //   mixed = out_scale * sum_c xn_c * sigmoid(gate_c)  [n_embd, n_tokens];  inject = w_inject xn  [hc, n_tokens] (0 without w_inject)
+    // result: f32 1-D, mixed (n_embd*n_tokens values) then inject (hc*n_tokens values)
+    GGML_API struct ggml_tensor * ggml_hc_mix(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * w_norm,
+            struct ggml_tensor  * w_down,
+            struct ggml_tensor  * w_up,
+            struct ggml_tensor  * w_inject,
+            float                 eps,
+            float                 scale,
+            float                 out_scale);
+
+    GGML_API struct ggml_tensor * ggml_moe_cpu_recv(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * experts,
+            struct ggml_tensor  * slots,
+            void                * box,
+            int                   flags);
+
     GGML_API struct ggml_tensor * ggml_dsv4_hc_post(
             struct ggml_context * ctx,
             struct ggml_tensor  * x,
