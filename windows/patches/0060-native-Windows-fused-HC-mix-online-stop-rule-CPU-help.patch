+    GGML_ASSERT(ggml_nelements(fetch->src[0]) <= GGML_MOE_CPU_MAX_JOBS && ggml_nelements(fetch->src[0]) % x->ne[1] == 0);
+    const uint64_t b = (uint64_t) (uintptr_t) box;
+    int32_t * p = (int32_t *) fetch->op_params;
